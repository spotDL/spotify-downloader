/* SpotDL CLI - Theme aligned with frontend design system
 * Colors from frontend/src/index.css
 */

/* ==================== CUSTOM COLORS ====================
 * Textual uses $primary, $secondary, etc. as built-in variables
 * We override them to match our frontend theme
 */

$accent-primary: #ff6b35;
$accent-secondary: #4ecdc4;
$accent-success: #00d084;
$accent-error: #ff3333;
$accent-warning: #ffd93d;

$bg-void: #08080a;
$bg-chassis: #0f1012;
$bg-panel: #161819;
$bg-elevated: #1c1e20;
$bg-surface: #242628;
$bg-hover: #2c2e32;

$text-primary: #fafafa;
$text-secondary: #a8a8b3;
$text-muted: #6b6b76;
$text-dim: #454550;

$border-color: #2f2f33;
$border-subtle: #232326;

/* Platform colors */
$platform-spotify: #1db954;
$platform-youtube: #ff0000;
$platform-deezer: #a238ff;
$platform-soundcloud: #ff5500;
$platform-bandcamp: #1da0c3;
$platform-apple: #fc3c44;
$platform-tidal: #000000;

/* ==================== GLOBAL ==================== */

Screen {
    background: $bg-chassis;
}

Header {
    background: $accent-primary;
    color: $text-primary;
    text-style: bold;
}

Footer {
    background: $bg-panel;
    color: $text-muted;
}

.hidden {
    display: none;
}

/* Modern scrollbar */
VerticalScroll {
    scrollbar-color: $bg-hover;
    scrollbar-color-hover: $accent-primary;
    scrollbar-color-active: $accent-primary;
    scrollbar-background: $bg-panel;
    scrollbar-background-hover: $bg-elevated;
}

/* ==================== TYPOGRAPHY ==================== */

.title-xl {
    text-style: bold;
    color: $text-primary;
    padding: 1 2;
}

.title-lg {
    text-style: bold;
    color: $accent-primary;
}

.title-md {
    text-style: bold;
    color: $text-primary;
}

.subtitle {
    color: $text-secondary;
    text-style: italic;
}

.label {
    color: $text-primary;
}

.hint {
    color: $text-muted;
    text-style: italic;
}

.link {
    color: $accent-secondary;
    text-style: underline;
}

/* ==================== MODERN CARDS ==================== */

.card {
    background: $bg-surface;
    border: wide $border-color;
    padding: 1 2;
    margin: 1 0;
}

.card-elevated {
    background: $bg-elevated;
    border: wide $border-color;
    padding: 1 2;
    margin: 1 0;
}

.card-header {
    height: auto;
    margin-bottom: 1;
}

.card-title {
    text-style: bold;
    color: $text-primary;
}

.card-subtitle {
    color: $text-secondary;
}

.card-body {
    padding: 1 0;
}

.card-footer {
    margin-top: 1;
    padding-top: 1;
    border-top: solid $border-color;
}

/* ==================== MODERN BUTTONS ==================== */

Button {
    background: $bg-surface;
    color: $text-primary;
    border: tall $border-color;
    padding: 0 2;
    margin: 0 1;
    min-width: 10;
}

Button:hover {
    background: $bg-hover;
    border: tall $accent-primary;
}

Button:focus {
    background: $bg-hover;
    border: tall $accent-primary;
}

Button.-primary {
    background: $accent-primary;
    color: $text-primary;
    border: tall $accent-primary;
}

Button.-primary:hover {
    background: #ff8555;
    border: tall #ff8555;
}

Button.-success {
    background: $accent-success;
    color: $bg-void;
    border: tall $accent-success;
}

Button.-success:hover {
    background: #00e08a;
}

Button.-warning {
    background: $accent-warning;
    color: $bg-void;
    border: tall $accent-warning;
}

Button.-error {
    background: $accent-error;
    color: $text-primary;
    border: tall $accent-error;
}

Button.-small {
    min-width: 6;
    padding: 0 1;
    height: 1;
}

/* ==================== MODERN INPUTS ==================== */

Input {
    background: $bg-surface;
    border: tall $border-color;
    padding: 0 1;
}

Input:focus {
    border: tall $accent-primary;
    background: $bg-elevated;
}

Input.-valid {
    border: tall $accent-success;
}

Input.-invalid {
    border: tall $accent-error;
}

Select {
    background: $bg-surface;
    border: tall $border-color;
}

Select:focus {
    border: tall $accent-primary;
    background: $bg-elevated;
}

Checkbox {
    background: transparent;
    padding: 0;
}

Checkbox:focus {
    background: $bg-elevated;
}

/* ==================== MODERN DATA TABLE ==================== */

DataTable {
    background: $bg-surface;
    height: 100%;
}

DataTable > .datatable--header {
    background: $bg-panel;
    color: $text-primary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent-primary;
    color: $text-primary;
}

DataTable > .datatable--hover {
    background: $bg-hover;
}

DataTable:focus > .datatable--cursor {
    background: $accent-primary;
}

/* ==================== PROGRESS & STATUS ==================== */

ProgressBar {
    padding: 0;
    height: 1;
}

ProgressBar > .bar--bar {
    color: $accent-primary;
}

ProgressBar > .bar--complete {
    color: $accent-success;
}

.status-indicator {
    padding: 0 1;
    text-align: center;
}

.status-success {
    color: $accent-success;
}

.status-warning {
    color: $accent-warning;
}

.status-error {
    color: $accent-error;
}

.status-info {
    color: $accent-secondary;
}

.status-muted {
    color: $text-muted;
}

/* ==================== BADGES ==================== */

.badge {
    width: auto;
    padding: 0 1;
    text-style: bold;
}

.badge-success {
    background: #003322;
    color: $accent-success;
}

.badge-warning {
    background: #332200;
    color: $accent-warning;
}

.badge-error {
    background: #330011;
    color: $accent-error;
}

.badge-info {
    background: #002233;
    color: $accent-secondary;
}

.badge-muted {
    background: $bg-elevated;
    color: $text-muted;
}

/* Platform badges */
.badge-spotify {
    background: #0a2615;
    color: $platform-spotify;
}

.badge-youtube {
    background: #330000;
    color: $platform-youtube;
}

.badge-deezer {
    background: #1a0033;
    color: $platform-deezer;
}

.badge-soundcloud {
    background: #331100;
    color: $platform-soundcloud;
}

.badge-apple {
    background: #330011;
    color: $platform-apple;
}

/* ==================== PLATFORM COLORS ==================== */

.platform-spotify {
    color: $platform-spotify;
}

.platform-youtube {
    color: $platform-youtube;
}

.platform-deezer {
    color: $platform-deezer;
}

.platform-soundcloud {
    color: $platform-soundcloud;
}

.platform-bandcamp {
    color: $platform-bandcamp;
}

.platform-apple {
    color: $platform-apple;
}

.platform-tidal {
    color: $text-primary;
}

/* ==================== DIVIDERS ==================== */

Rule {
    color: $border-color;
    margin: 1 0;
}

.divider-light {
    color: $border-subtle;
}

.divider-accent {
    color: $accent-primary;
}

/* ==================== MAIN SCREEN ==================== */

/* Main container — full bleed, tight padding */
#main-container {
    width: 100%;
    height: 100%;
    padding: 0 1;
}

/* ---- Search bar: single compact row ---- */
#search-bar {
    height: 3;
    width: 100%;
    align: left middle;
    margin-bottom: 0;
    padding: 0;
    background: $bg-panel;
    border-bottom: solid $border-subtle;
}

#search-icon {
    width: 3;
    text-align: center;
    color: $accent-primary;
}

#search-input {
    width: 1fr;
    margin: 0;
    border: none;
    background: $bg-panel;
}

#search-input:focus {
    border: none;
    background: $bg-elevated;
}

#search-btn {
    width: auto;
    min-width: 10;
    margin: 0;
    height: 3;
}

#status-bar {
    height: 1;
    width: auto;
    min-width: 20;
    padding: 0 1;
    color: $text-muted;
    text-align: right;
}

/* ---- Filter pills: compact row ---- */
#filter-tabs {
    height: auto;
    max-height: 3;
    margin: 0;
    padding: 0 1;
    align: left middle;
    background: $bg-chassis;
    border-bottom: solid $border-subtle;
}

.filter-btn {
    min-width: 8;
    padding: 0 2;
    margin-right: 1;
    background: $bg-surface;
    border: tall $border-color;
}

.filter-btn:hover {
    background: $bg-hover;
    border: tall $accent-primary;
}

.filter-btn:focus {
    background: $bg-hover;
    border: tall $accent-primary;
}

.filter-btn.active {
    background: $accent-primary;
    color: $text-primary;
    border: tall $accent-primary;
}

/* ---- Results container ---- */
#results-container {
    height: auto;
    padding: 0 1;
}

/* ---- Entity sections ---- */
.entity-section {
    height: auto;
    margin-bottom: 1;
}

.section-header {
    height: auto;
    margin: 1 0 0 0;
    align: left middle;
}

.section-title {
    text-style: bold;
    padding: 0;
}

.section-count {
    color: $text-muted;
    margin-left: 1;
}

/* Entity type colors */
.artist-color {
    color: $accent-warning;
}

.album-color {
    color: $accent-secondary;
}

.track-color {
    color: $accent-success;
}

.playlist-color {
    color: $accent-primary;
}

/* ---- Artist grid: compact tiles in a wrapping horizontal row ---- */
.artist-grid {
    height: auto;
    width: 100%;
    padding: 0;
    overflow-x: auto;
}

.artist-tile {
    width: 22;
    height: auto;
    padding: 0 1;
    margin: 0 1 0 0;
    background: $bg-elevated;
    border: wide $border-color;
    text-align: center;
    content-align: center top;
}

.artist-tile:hover {
    background: $bg-hover;
    border: wide $accent-warning;
}

.artist-tile:focus {
    background: $bg-hover;
    border: wide $accent-warning;
}

.artist-tile-cover {
    width: 18;
    height: 5;
    background: $bg-surface;
    border: solid $border-subtle;
    overflow: hidden;
    content-align: center middle;
    margin: 0;
}

.tile-name {
    color: $text-primary;
    text-style: bold;
    height: 1;
    text-align: center;
}

.tile-meta {
    color: $text-muted;
    height: 1;
    text-align: center;
}

.tile-action {
    width: 1fr;
    min-width: 6;
    padding: 0 1;
    margin: 0;
    background: $bg-surface;
    border: tall $border-color;
}

.tile-action:hover {
    background: $accent-primary;
    border: tall $accent-primary;
}

.tile-action-dl {
    background: $bg-surface;
}

.tile-action-dl:hover {
    background: $accent-success;
    border: tall $accent-success;
}

.tile-actions-row {
    height: auto;
    width: 100%;
    align: center middle;
}

/* ---- Album grid: compact tiles ---- */
.album-grid {
    height: auto;
    width: 100%;
    padding: 0;
    overflow-x: auto;
}

.album-tile {
    width: 22;
    height: auto;
    padding: 0 1;
    margin: 0 1 0 0;
    background: $bg-elevated;
    border: wide $border-color;
    text-align: center;
    content-align: center top;
}

.album-tile:hover {
    background: $bg-hover;
    border: wide $accent-secondary;
}

.album-tile:focus {
    background: $bg-hover;
    border: wide $accent-secondary;
}

.album-tile-cover {
    width: 18;
    height: 5;
    background: $bg-surface;
    border: solid $border-subtle;
    overflow: hidden;
    content-align: center middle;
    margin: 0;
}

/* ---- Compact track/playlist rows ---- */
.track-list {
    height: auto;
    width: 100%;
}

.compact-row {
    height: auto;
    max-height: 5;
    width: 100%;
    padding: 0 1;
    margin: 0;
    background: $bg-elevated;
    border-bottom: solid $border-subtle;
    align: left middle;
}

.compact-row:hover {
    background: $bg-hover;
}

.compact-row:focus {
    background: $bg-hover;
    border-bottom: solid $accent-primary;
}

.row-icon {
    width: 3;
    text-align: center;
    height: 1;
}

.row-info {
    width: 1fr;
    height: auto;
    padding: 0;
}

.row-title {
    color: $text-primary;
    height: 1;
}

.row-subtitle {
    color: $text-secondary;
    height: 1;
}

.row-platforms {
    width: auto;
    height: 1;
    margin: 0 1;
}

.row-duration {
    width: 6;
    text-align: right;
    height: 1;
}

.row-action {
    width: auto;
    min-width: 4;
    padding: 0;
    margin: 0;
    background: $bg-elevated;
    border: tall $border-subtle;
    color: $text-muted;
}

.row-action:hover {
    color: $accent-primary;
    background: $bg-surface;
    border: tall $accent-primary;
}

.row-action-dl:hover {
    color: $accent-success;
    border: tall $accent-success;
}

/* ---- Card cover (generic, used in tiles) ---- */
.card-cover {
    overflow: hidden;
    content-align: center middle;
}

/* ---- Empty states ---- */
#empty-state {
    height: auto;
    padding: 3;
    text-align: center;
    align: center middle;
}

.empty-state {
    height: auto;
    padding: 3;
    text-align: center;
}

.empty-message {
    color: $text-secondary;
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
}

.empty-hint {
    color: $text-muted;
    text-style: italic;
    text-align: center;
}

#no-results {
    height: auto;
    padding: 3;
    text-align: center;
    align: center middle;
}

/* ---- Load More buttons ---- */
.load-more-btn {
    width: 100%;
    margin: 1 0 0 0;
    padding: 0 2;
    background: $bg-surface;
    border: tall $border-color;
    color: $text-muted;
}

.load-more-btn:hover {
    background: $bg-hover;
    border: tall $accent-primary;
    color: $text-primary;
}

.load-more-btn:focus {
    background: $bg-hover;
    border: tall $accent-primary;
}

/* ---- Entity type badges (used in detail screens) ---- */
.badge-artist {
    background: #332200;
    color: $accent-warning;
}

.badge-track {
    background: #003322;
    color: $accent-success;
}

.badge-album {
    background: #002233;
    color: $accent-secondary;
}

.badge-playlist {
    background: #331100;
    color: $accent-primary;
}

/* Platform badges */
.platform-badges {
    width: auto;
    height: auto;
    margin-left: 1;
}

.platform-badge {
    width: auto;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

/* ---- Legacy card styles (kept for detail screens) ---- */
.card-info {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

.card-title {
    color: $text-primary;
    text-style: bold;
}

.card-subtitle {
    color: $text-secondary;
}

.card-action {
    width: auto;
    height: auto;
    padding: 0;
}

.card-meta-row {
    height: auto;
    align: left middle;
    margin-bottom: 0;
}

.entity-card {
    height: 9;
    max-width: 120;
    padding: 0 1;
    margin-bottom: 0;
    background: $bg-elevated;
    border: wide $border-color;
    align: left middle;
}

.entity-card:hover {
    background: $bg-hover;
    border: wide $accent-primary;
}

.card-cover-small {
    width: 14;
    height: 7;
    background: $bg-surface;
    border: wide $border-color;
}

/* Info panel sections */
.info-section {
    margin-bottom: 2;
}

.info-section-title {
    text-style: bold;
    color: $accent-primary;
    margin-bottom: 1;
    padding: 0 1;
}

.info-section-content {
    padding: 0 1;
}

.provider-item {
    height: 1;
    margin-bottom: 0;
}

.config-item {
    height: 1;
    margin-bottom: 0;
    color: $text-muted;
}

#quick-tips {
    padding: 0;
    color: $text-muted;
}

/* ==================== ONBOARDING SCREEN ==================== */

#onboarding-container {
    width: 100%;
    height: 100%;
    background: $bg-chassis;
}

/* Progress header */
#onboarding-header {
    dock: top;
    height: 5;
    background: $bg-panel;
    border-bottom: wide $border-color;
    padding: 1 2;
}

#progress-steps {
    height: auto;
    align: center middle;
}

.step-item {
    width: auto;
    padding: 0 2;
    text-align: center;
}

.step-number {
    text-style: bold;
}

.step-number-active {
    color: $accent-primary;
}

.step-number-complete {
    color: $accent-success;
}

.step-number-pending {
    color: $text-muted;
}

.step-connector {
    width: 4;
    color: $border-color;
}

.step-connector-complete {
    color: $accent-success;
}

#step-title {
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

/* Content area */
#onboarding-content {
    height: 1fr;
    padding: 2 4;
}

.onboarding-step {
    width: 100%;
    max-width: 80;
    margin: 0 2;
}

/* Welcome step */
#welcome-content {
    text-align: center;
}

#welcome-logo {
    color: $accent-primary;
    text-style: bold;
    padding: 1;
}

#welcome-title {
    text-style: bold;
    color: $text-primary;
    padding: 1;
}

#welcome-subtitle {
    color: $text-secondary;
    padding: 1;
}

.feature-grid {
    margin: 2 0;
}

.feature-item {
    margin: 1 0;
    padding: 1 2;
    background: $bg-surface;
    border: wide $border-color;
}

.feature-icon {
    color: $accent-primary;
    width: 4;
}

.feature-text {
    width: 1fr;
}

.feature-title {
    text-style: bold;
    color: $text-primary;
}

.feature-desc {
    color: $text-secondary;
}

/* Config cards */
.config-card {
    background: $bg-surface;
    border: wide $border-color;
    padding: 1 2;
    margin-bottom: 2;
}

.config-card-header {
    height: auto;
    margin-bottom: 1;
}

.config-card-icon {
    color: $accent-primary;
    width: 3;
}

.config-card-title {
    text-style: bold;
    color: $text-primary;
}

.config-card-desc {
    color: $text-secondary;
    margin-bottom: 1;
}

.config-input {
    width: 100%;
    margin-top: 1;
}

.config-select {
    width: 100%;
    margin-top: 1;
}

/* Credentials card */
.credentials-card {
    background: $bg-surface;
    border: wide $accent-primary;
    padding: 1 2;
    margin: 1 0;
}

.credentials-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.credentials-title {
    text-style: bold;
    color: $text-primary;
    width: auto;
}

.credentials-badge {
    margin-left: 2;
    background: #332200;
    color: $accent-warning;
    padding: 0 1;
    text-style: bold;
}

.cred-status-bar {
    height: 3;
    margin: 1 0;
    padding: 1;
    text-align: center;
    background: $bg-elevated;
    border: wide $border-color;
}

.cred-status-bar.configured {
    background: #003322;
    border: wide $accent-success;
}

.cred-status-bar.partial {
    background: #332200;
    border: wide $accent-warning;
}

.cred-field {
    margin: 1 0;
}

.cred-field-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.cred-field-label {
    text-style: bold;
    color: $text-primary;
    width: auto;
}

.toggle-btn {
    min-width: 8;
    height: 1;
    margin-left: 2;
    padding: 0 1;
}

.auth-section {
    margin-top: 1;
    padding-top: 1;
    border-top: solid $border-color;
}

.auth-hint {
    color: $text-muted;
    text-style: italic;
    padding-left: 4;
}

/* Instructions */
.instructions-card {
    margin-top: 2;
    background: $bg-elevated;
    border: dashed $border-color;
    padding: 1;
}

.instructions-btn {
    width: 100%;
    background: transparent;
    border: none;
    color: $accent-secondary;
}

#instructions-content {
    margin-top: 1;
    padding: 1;
}

.skip-note {
    color: $text-muted;
    text-style: italic;
    text-align: center;
    margin-top: 2;
}

/* Complete step */
#complete-content {
    text-align: center;
}

#complete-icon {
    color: $accent-success;
    padding: 1;
}

#complete-title {
    text-style: bold;
    color: $text-primary;
    padding: 1;
}

.tips-grid {
    margin: 2 0;
}

.tip-item {
    margin: 1 0;
    padding: 1;
    text-align: left;
}

.tip-key {
    color: $accent-primary;
    text-style: bold;
    width: 8;
}

.tip-desc {
    color: $text-primary;
}

/* Navigation */
#onboarding-nav {
    dock: bottom;
    height: 5;
    background: $bg-panel;
    border-top: wide $border-color;
    padding: 1 4;
    align: center middle;
}

#onboarding-nav Button {
    margin: 0 2;
    min-width: 14;
}

/* ==================== QUEUE SCREEN ==================== */

#queue-container {
    padding: 1 2;
    height: 100%;
}

#queue-header {
    height: 5;
    margin-bottom: 1;
}

#queue-title-row {
    height: auto;
    align: left middle;
}

#queue-title {
    text-style: bold;
    color: $accent-primary;
    width: auto;
}

#queue-stats-row {
    height: auto;
    margin-top: 1;
}

.queue-stat {
    width: auto;
    margin-right: 3;
}

.queue-stat-value {
    text-style: bold;
    color: $text-primary;
}

.queue-stat-label {
    color: $text-muted;
}

#queue-table-container {
    height: 1fr;
    background: $bg-surface;
    border: wide $border-color;
}

#queue-table {
    width: 100%;
    height: 100%;
}

#progress-section {
    height: auto;
    margin-top: 1;
    padding: 0 1;
}

#current-download {
    height: auto;
    color: $text-secondary;
    margin-bottom: 0;
}

#queue-actions {
    height: 3;
    margin-top: 1;
    align: left middle;
}

/* Download status colors */
.dl-pending {
    color: $text-muted;
}

.dl-searching {
    color: $accent-warning;
}

.dl-downloading {
    color: $accent-primary;
}

.dl-converting {
    color: $accent-secondary;
}

.dl-embedding {
    color: $accent-secondary;
}

.dl-completed {
    color: $accent-success;
}

.dl-failed {
    color: $accent-error;
}

.dl-cancelled {
    color: $text-muted;
}

/* ==================== SETTINGS SCREEN ==================== */

#settings-container {
    padding: 1 2;
    width: 100%;
    height: 100%;
}

#settings-header {
    height: 5;
    margin-bottom: 1;
    border-bottom: wide $border-color;
    padding-bottom: 1;
}

#settings-title {
    text-style: bold;
    color: $accent-primary;
}

#settings-subtitle {
    color: $text-secondary;
}

/* Settings groups */
.settings-group {
    background: $bg-surface;
    border: wide $border-color;
    padding: 1 2;
    margin-bottom: 2;
    height: auto;
    width: 100%;
}

.settings-group Static {
    height: auto;
    width: 100%;
}

.settings-group Label {
    height: auto;
}

.settings-group Input {
    height: 3;
}

.settings-group Select {
    height: 3;
}

.settings-group Checkbox {
    height: auto;
}

.settings-group Horizontal {
    height: auto;
    width: 100%;
}

.settings-group Vertical {
    height: auto;
    width: 100%;
}

.settings-group-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.settings-group-icon {
    color: $accent-primary;
    width: 3;
}

.settings-group-title {
    text-style: bold;
    color: $text-primary;
    width: auto;
}

.settings-group-badge {
    margin-left: 2;
}

.settings-group-desc {
    color: $text-secondary;
    margin-bottom: 1;
}

/* Group title used in settings.py */
.group-title {
    text-style: bold;
    color: $accent-primary;
    margin-bottom: 1;
    height: auto;
    width: 100%;
}

.setting-row {
    height: auto;
    min-height: 3;
    align: left middle;
    margin: 1 0;
}

.setting-row Label {
    width: 25;
    color: $text-primary;
}

.setting-row Input {
    width: 1fr;
}

.setting-row Select {
    width: 1fr;
}

.setting-row Checkbox {
    width: 1fr;
}

.setting-label {
    width: 35%;
    color: $text-primary;
}

.setting-input {
    width: 65%;
}

.setting-hint {
    color: $text-muted;
    text-style: italic;
    padding: 0 1;
}

/* Help text */
.help-text {
    color: $text-muted;
    height: auto;
}

.section-desc {
    margin-bottom: 1;
}

/* Group header (used in credentials sections) */
.group-header {
    height: auto;
    width: 100%;
    align: left middle;
}

/* Status badges */
.status-badge {
    margin-left: 2;
    height: auto;
}

/* Credentials section styling */
.credentials-section {
    border: wide $accent-primary;
}

.cred-field-group {
    height: auto;
    margin: 1 0;
}

.cred-label-row {
    height: auto;
    width: 100%;
    align: left middle;
    margin-bottom: 1;
}

.cred-label {
    width: auto;
    color: $text-primary;
}

.toggle-visibility-btn {
    margin-left: 2;
    min-width: 8;
}

.cred-input {
    width: 100%;
    height: 3;
}

.cred-option-group {
    height: auto;
    margin: 1 0;
}

.option-hint {
    color: $text-muted;
    text-style: italic;
    height: auto;
}

.cred-help-link {
    color: $accent-secondary;
    height: auto;
    margin-top: 1;
}

/* Credential sections in settings */
.credentials-group {
    background: $bg-surface;
    border: wide $accent-primary;
    padding: 1 2;
    margin-bottom: 2;
}

.cred-group-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.cred-group-title {
    text-style: bold;
    color: $text-primary;
    width: auto;
}

.cred-group-status {
    margin-left: 2;
}

.cred-group-desc {
    color: $text-secondary;
    margin-bottom: 1;
}

.cred-row {
    margin: 1 0;
}

.cred-row-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.cred-row-label {
    text-style: bold;
    color: $text-primary;
    width: auto;
}

.visibility-btn {
    min-width: 8;
    height: 1;
    margin-left: 2;
}

.cred-row-input {
    width: 100%;
}

.cred-option {
    margin: 1 0;
    padding: 1 0;
}

.cred-option-hint {
    color: $text-muted;
    text-style: italic;
    padding-left: 4;
}

.cred-help {
    color: $accent-secondary;
    text-style: italic;
    padding: 1 0;
}

/* Settings actions */
#settings-actions {
    height: 5;
    margin-top: 2;
    padding-top: 1;
    border-top: wide $border-color;
    align: center middle;
}

#settings-actions Button {
    margin: 0 2;
    min-width: 16;
}

/* ==================== MARKDOWN ==================== */

Markdown {
    padding: 1;
    background: transparent;
}

MarkdownH1 {
    color: $accent-primary;
    text-style: bold;
    padding: 1 0;
}

MarkdownH2 {
    color: $text-primary;
    text-style: bold;
    padding: 1 0;
}

MarkdownH3 {
    color: $text-primary;
    text-style: bold;
    padding: 1 0;
}

MarkdownBulletList {
    padding-left: 2;
}

MarkdownOrderedList {
    padding-left: 2;
}

/* ==================== DETAIL SCREENS (Track/Album/Artist/Playlist) ==================== */

/* Hero sections */
.hero-section {
    background: $bg-panel;
    padding: 1 2;
    margin-bottom: 1;
    border-bottom: wide $border-color;
}

#track-hero-content,
#album-hero-content,
#artist-hero-content,
#playlist-hero-content {
    height: auto;
    min-height: 13;
    align: left top;
}

/* CoverArt widget */
CoverArt {
    overflow: hidden;
}

CoverArt #cover-image {
    width: 1fr;
    height: 1fr;
}

/* Cover/Avatar placeholders */
.cover-placeholder {
    width: 22;
    height: 11;
    background: $bg-surface;
    border: wide $border-color;
    content-align: center middle;
    margin-right: 2;
}

.cover-placeholder-large {
    width: 26;
    height: 13;
    background: $bg-surface;
    border: wide $border-color;
    content-align: center middle;
    margin-right: 2;
}

.avatar-placeholder {
    width: 22;
    height: 11;
    background: $bg-surface;
    border: wide $accent-primary;
    content-align: center middle;
    margin-right: 2;
}

/* Info sections */
#track-info,
#album-info,
#artist-info,
#playlist-info {
    width: 1fr;
}

/* Badges rows */
#track-badges,
#album-badges {
    height: auto;
    margin-bottom: 1;
}

/* Stats rows */
.stats-row {
    height: auto;
    margin: 1 0;
}

.stat-item {
    width: auto;
    margin-right: 3;
}

/* Genre row */
.genre-row {
    height: auto;
    margin: 1 0;
}

.genre-row .badge {
    margin-right: 1;
}

/* Actions row */
.actions-row {
    height: auto;
    margin-top: 1;
}

.actions-row Button {
    margin-right: 1;
}

/* Detail row (for ISRC, Label, etc.) */
.detail-row {
    height: auto;
    margin: 0;
    color: $text-secondary;
}

/* Description text */
.description-text {
    color: $text-secondary;
    max-height: 4;
    overflow: hidden;
    margin: 1 0;
}

/* Content grids */
#track-content,
#album-content,
#artist-content,
#playlist-content {
    width: 100%;
    height: 1fr;
    padding: 1;
}

/* Main column (left, 2/3 width) */
.main-column {
    width: 66%;
    padding-right: 1;
}

/* Sidebar column (right, 1/3 width) */
.sidebar-column {
    width: 34%;
    padding-left: 1;
    border-left: wide $border-color;
}

/* Stats grid */
.stats-grid {
    height: auto;
}

.stat-box {
    width: 1fr;
    text-align: center;
    padding: 1;
}

.stat-value {
    text-style: bold;
    color: $accent-primary;
}

.stat-label {
    color: $text-muted;
}

/* Bio text */
.bio-text {
    color: $text-secondary;
    max-height: 8;
    overflow: hidden;
}

/* Feature rows (for audio features) */
.feature-row {
    height: auto;
    margin: 1 0;
    align: left middle;
}

.feature-label {
    width: 12;
    color: $text-secondary;
}

.feature-value {
    color: $text-primary;
    text-style: bold;
}

.feature-row ProgressBar {
    width: 1fr;
}

/* Lyrics display */
.lyrics-scroll {
    max-height: 20;
    background: $bg-elevated;
    padding: 1;
    border: wide $border-color;
}

.lyrics-text {
    color: $text-secondary;
}

/* Matches container */
#matches-container {
    height: auto;
    min-height: 10;
}

#matches-table {
    height: 100%;
    min-height: 8;
}

/* Tracks container */
#tracks-container {
    height: auto;
    min-height: 10;
}

#tracks-table {
    height: 100%;
    min-height: 8;
}

/* Top tracks container */
#top-tracks-container {
    height: auto;
    min-height: 8;
}

#top-tracks-table {
    height: 100%;
    min-height: 6;
}

/* Album tables */
#albums-table-all,
#albums-table-albums,
#albums-table-singles,
#albums-table-eps {
    height: 100%;
    min-height: 6;
}

/* Tabbed content */
#discography-tabs {
    height: auto;
    min-height: 10;
}

TabbedContent {
    height: auto;
}

TabPane {
    height: auto;
    padding: 1;
}

ContentSwitcher {
    height: auto;
}

/* Detail containers */
#track-container,
#album-container,
#artist-container,
#playlist-container {
    width: 100%;
    height: 100%;
    background: $bg-chassis;
}

/* ==================== RESPONSIVE ==================== */

/* Adjustments for smaller terminals handled by Textual's responsive system */
