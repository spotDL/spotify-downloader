/* SpotDL CLI — "Midnight Vinyl" design system
 *
 * Premium audio feel, clean matte surfaces with warm accent pops,
 * depth through layering (bg-color differences, not borders everywhere),
 * accent restraint, spacing-driven hierarchy.
 *
 * Sections:
 *  1. Variables
 *  2. Global
 *  3. Navigation
 *  4. Components
 *  5. Typography
 *  6. Search screen
 *  7. Detail screens
 *  8. Track-specific
 *  9. Queue screen
 * 10. Settings screen
 * 11. Modals
 * 12. Admin
 * 13. Onboarding
 * 14. Account screen
 * 15. Responsive / text utilities
 */


/* ==========================================================================
   1. VARIABLES — Design tokens
   ========================================================================== */

/* Accent palette */
$accent-primary: #e8764b;
$accent-secondary: #4ecdc4;
$accent-success: #00d084;
$accent-error: #ff3333;
$accent-warning: #ffd93d;
$accent-focus: #c4a35a;

/* Backgrounds (darkest -> lightest) */
$bg-void: #08080a;
$bg-inset: #0c0c0e;
$bg-chassis: #0f1012;
$bg-panel: #161819;
$bg-elevated: #1c1e20;
$bg-surface: #242628;
$bg-hover: #2c2e32;

/* Text */
$text-primary: #fafafa;
$text-accent: #e8e0d0;
$text-secondary: #a8a8b3;
$text-muted: #6b6b76;
$text-dim: #454550;

/* Borders */
$border-color: #2f2f33;
$border-subtle: #232326;

/* Platform colors */
$platform-spotify: #1db954;
$platform-youtube: #ff0000;
$platform-deezer: #a238ff;
$platform-soundcloud: #ff5500;
$platform-bandcamp: #1da0c3;
$platform-apple: #fc3c44;
$platform-tidal: #000000;


/* ==========================================================================
   2. GLOBAL — Screen, scrollbar, hidden class
   ========================================================================== */

Screen {
    background: $bg-chassis;
}

Header {
    background: $bg-panel;
    color: $text-accent;
    text-style: bold;
}

Footer {
    background: $bg-panel;
    color: $text-muted;
}

.hidden {
    display: none;
}

/* Scrollbar — subtle, warms on hover */
VerticalScroll {
    scrollbar-color: $bg-hover;
    scrollbar-color-hover: $accent-primary;
    scrollbar-color-active: $accent-primary;
    scrollbar-background: $bg-chassis;
    scrollbar-background-hover: $bg-panel;
}


/* ==========================================================================
   3. NAVIGATION — NavRail, StatusBar (supplemental integration styles)
   ========================================================================== */

/* NavRail — widget provides its own DEFAULT_CSS; add integration tweaks */
NavRail {
    transition: width 150ms;
}

/* StatusBar — widget provides its own DEFAULT_CSS */
StatusBar {
    border-top: solid $border-subtle;
}


/* ==========================================================================
   4. COMPONENTS — Cards, buttons, inputs, badges, DataTable, progress, status
   ========================================================================== */

/* ---- Cards ---- */

.card {
    background: $bg-surface;
    border: none;
    padding: 1 2;
    margin: 1 0;
}

.card:focus-within {
    border-left: thick $accent-primary;
}

.card-elevated {
    background: $bg-elevated;
    border: none;
    padding: 1 2;
    margin: 1 0;
}

.card-header {
    height: auto;
    margin-bottom: 1;
}

.card-title {
    text-style: bold;
    color: $text-accent;
}

.card-subtitle {
    color: $text-secondary;
}

.card-body {
    padding: 1 0;
}

.card-footer {
    margin-top: 1;
    padding-top: 1;
    border-top: solid $border-subtle;
}

/* ---- Buttons ---- */

Button {
    background: $bg-surface;
    color: $text-primary;
    border: solid $border-color;
    padding: 0 2;
    margin: 0 1;
    min-width: 10;
    transition: background 200ms;
}

Button:hover {
    background: $bg-hover;
    border: solid $accent-primary;
}

Button:focus {
    background: $bg-hover;
    border: solid $accent-focus;
    transition: border 150ms;
}

Button.-primary {
    background: $accent-primary;
    color: $text-primary;
    border: solid $accent-primary;
}

Button.-primary:hover {
    background: #d0684a;
    border: solid #d0684a;
}

Button.-success {
    background: $accent-success;
    color: $bg-void;
    border: solid $accent-success;
}

Button.-success:hover {
    background: #00e08a;
}

Button.-warning {
    background: $accent-warning;
    color: $bg-void;
    border: solid $accent-warning;
}

Button.-error {
    background: $accent-error;
    color: $text-primary;
    border: solid $accent-error;
}

Button.-small {
    min-width: 6;
    padding: 0 1;
    height: 1;
}

/* ---- Inputs ---- */

Input {
    background: $bg-surface;
    border: solid $border-color;
    padding: 0 1;
}

Input:focus {
    border: solid $accent-focus;
    background: $bg-elevated;
    transition: border 150ms;
}

Input.-valid {
    border: solid $accent-success;
}

Input.-invalid {
    border: solid $accent-error;
}

Select {
    background: $bg-surface;
    border: solid $border-color;
}

Select:focus {
    border: solid $accent-focus;
    background: $bg-elevated;
}

Checkbox {
    background: transparent;
    padding: 0;
}

Checkbox:focus {
    background: $bg-elevated;
}

/* ---- Badges ---- */

.badge {
    width: auto;
    padding: 0 1;
    text-style: bold;
}

.badge-success {
    background: #003322;
    color: $accent-success;
}

.badge-warning {
    background: #332200;
    color: $accent-warning;
}

.badge-error {
    background: #330011;
    color: $accent-error;
}

.badge-info {
    background: #002233;
    color: $accent-secondary;
}

.badge-muted {
    background: $bg-elevated;
    color: $text-muted;
}

/* Platform badges */
.badge-spotify {
    background: #0a2615;
    color: $platform-spotify;
}

.badge-youtube {
    background: #330000;
    color: $platform-youtube;
}

.badge-deezer {
    background: #1a0033;
    color: $platform-deezer;
}

.badge-soundcloud {
    background: #331100;
    color: $platform-soundcloud;
}

.badge-apple {
    background: #330011;
    color: $platform-apple;
}

/* Entity type badges */
.badge-artist {
    background: #332200;
    color: $accent-warning;
}

.badge-track {
    background: #003322;
    color: $accent-success;
}

.badge-album {
    background: #002233;
    color: $accent-secondary;
}

.badge-playlist {
    background: #331100;
    color: $accent-primary;
}

/* Album type badges */
.badge-album-single {
    background: #1a0033;
    color: $platform-deezer;
}

.badge-album-ep {
    background: #002233;
    color: $accent-secondary;
}

.badge-album-compilation {
    background: #332200;
    color: $accent-warning;
}

/* Match badges */
.match-badge {
    padding: 0 1;
    text-style: bold;
}

.match-badge-best {
    background: #003322;
    color: $accent-success;
}

.match-badge-user {
    background: #002233;
    color: $accent-secondary;
}

.match-badge-pending {
    background: #332200;
    color: $accent-warning;
}

.match-badge-verified {
    background: #003322;
    color: $accent-success;
}

/* ---- DataTable ---- */

DataTable {
    background: $bg-surface;
    border: none;
    height: auto;
    max-height: 100%;
}

DataTable > .datatable--header {
    background: $bg-elevated;
    color: $text-accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent-primary;
    color: $text-primary;
}

DataTable > .datatable--hover {
    background: $bg-hover;
}

DataTable:focus > .datatable--cursor {
    background: $accent-primary;
}

DataTable > .datatable--even-row {
    background: $bg-inset;
}

/* ---- Progress & Status ---- */

ProgressBar {
    padding: 0;
    height: 1;
}

ProgressBar > .bar--bar {
    color: $accent-primary;
}

ProgressBar > .bar--complete {
    color: $accent-success;
}

.status-indicator {
    padding: 0 1;
    text-align: center;
}

.status-success {
    color: $accent-success;
}

.status-warning {
    color: $accent-warning;
}

.status-error {
    color: $accent-error;
}

.status-info {
    color: $accent-secondary;
}

.status-muted {
    color: $text-muted;
}

/* ---- Dividers ---- */

Rule {
    color: $border-subtle;
    margin: 1 0;
}

.divider-light {
    color: $border-subtle;
}

.divider-accent {
    color: $accent-primary;
}

/* ---- Platform colors ---- */

.platform-spotify {
    color: $platform-spotify;
}

.platform-youtube {
    color: $platform-youtube;
}

.platform-deezer {
    color: $platform-deezer;
}

.platform-soundcloud {
    color: $platform-soundcloud;
}

.platform-bandcamp {
    color: $platform-bandcamp;
}

.platform-apple {
    color: $platform-apple;
}

.platform-tidal {
    color: $text-primary;
}

/* ---- Platform badge container ---- */
.platform-badges {
    width: auto;
    height: auto;
    margin-left: 1;
}

.platform-badge {
    width: auto;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

/* ---- Collapsible ---- */

Collapsible {
    background: $bg-surface;
    border: solid $border-subtle;
    padding: 0;
    margin: 1 0;
}

/* ---- Markdown ---- */

Markdown {
    padding: 1;
    background: transparent;
}

MarkdownH1 {
    color: $accent-primary;
    text-style: bold;
    padding: 1 0;
}

MarkdownH2 {
    color: $text-accent;
    text-style: bold;
    padding: 1 0;
}

MarkdownH3 {
    color: $text-accent;
    text-style: bold;
    padding: 1 0;
}

MarkdownBulletList {
    padding-left: 2;
}

MarkdownOrderedList {
    padding-left: 2;
}

/* ---- Tabbed content ---- */

TabbedContent {
    height: auto;
}

TabPane {
    height: auto;
    padding: 1;
}

ContentSwitcher {
    height: auto;
}

/* ---- Error message ---- */

.error-message {
    color: $accent-error;
    padding: 0 1;
    margin: 1 0;
}


/* ==========================================================================
   5. TYPOGRAPHY — Title classes, links, hints
   ========================================================================== */

.title-xl {
    text-style: bold;
    color: $text-accent;
    padding: 1 2;
}

.title-lg {
    text-style: bold;
    color: $accent-primary;
}

.title-md {
    text-style: bold;
    color: $text-accent;
}

.title {
    text-style: bold;
    color: $text-accent;
}

.subtitle {
    color: $text-secondary;
    text-style: italic;
}

.label {
    color: $text-primary;
}

.hint {
    color: $text-muted;
    text-style: italic;
}

.link {
    color: $accent-secondary;
    text-style: underline;
}


/* ==========================================================================
   6. SEARCH SCREEN — Filters, entity sections, entity cards
   ========================================================================== */

/* Main container */
#main-container {
    width: 100%;
    height: 100%;
    padding: 1 2;
    background: $bg-chassis;
}

/* ---- Search bar ---- */
#search-bar {
    height: 5;
    width: 100%;
    align: left middle;
    margin-bottom: 1;
    padding: 1 2;
    background: $bg-panel;
    border-bottom: solid $border-subtle;
}

#search-icon {
    width: 3;
    height: 3;
    content-align: center middle;
    color: $accent-primary;
}

#search-input {
    width: 1fr;
    height: 3;
    margin: 0 1;
    padding: 0 1;
    border: solid $border-color;
    background: $bg-surface;
}

#search-input:focus {
    border: solid $accent-focus;
    background: $bg-surface;
}

#search-btn {
    width: auto;
    min-width: 12;
    margin: 0 1;
    height: 3;
}

#search-bar #refresh-btn {
    width: auto;
    min-width: 10;
    margin: 0 1;
    height: 3;
}

#search-bar #login-btn {
    width: auto;
    min-width: 10;
    margin: 0 1;
    height: 3;
}

#status-bar {
    height: 3;
    width: auto;
    min-width: 20;
    padding: 0 1;
    color: $text-muted;
    content-align: right middle;
}

/* ---- Filter pills ---- */
#filter-tabs {
    height: auto;
    max-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    align: left middle;
    background: $bg-chassis;
    border-bottom: solid $border-subtle;
}

#connection-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-align: right;
}

.filter-btn {
    min-width: 8;
    padding: 0 2;
    margin-right: 1;
    background: $bg-surface;
    border: solid $border-color;
}

.filter-btn:hover {
    background: $bg-hover;
    border: solid $accent-primary;
}

.filter-btn:focus {
    background: $bg-hover;
    border: solid $accent-focus;
}

.filter-btn.active {
    background: $accent-primary;
    color: $text-primary;
    border: solid $accent-primary;
}

/* ---- Filter tabs (Static-based, used in MainScreen) ---- */
.filter-tab {
    width: auto;
    padding: 0 2;
    margin-right: 1;
    height: 3;
    content-align: center middle;
    color: $text-muted;
    background: $bg-surface;
}
.filter-tab:hover {
    color: $text-primary;
    background: $bg-hover;
}
.filter-tab-active {
    color: $accent-primary;
    text-style: bold;
    border-bottom: solid $accent-primary;
}

/* ---- Entity list container ---- */
.entity-list {
    height: auto;
    width: 100%;
}

/* ---- Results container ---- */
#results-container {
    height: auto;
    padding: 0 1;
}

/* ---- Entity sections ---- */
.entity-section {
    height: auto;
    margin-bottom: 2;
}

.section-header {
    height: auto;
    margin: 1 0 1 0;
    align: left middle;
}

.section-title {
    text-style: bold;
    padding: 0;
}

.section-count {
    color: $text-muted;
    margin-left: 1;
}

/* Entity type colors */
.artist-color {
    color: $accent-warning;
}

.album-color {
    color: $accent-secondary;
}

.track-color {
    color: $accent-success;
}

.playlist-color {
    color: $accent-primary;
}

/* ---- Artist grid ---- */
.artist-grid {
    height: auto;
    width: 100%;
    padding: 0;
    overflow-x: auto;
}

.artist-tile {
    width: 28;
    min-height: 18;
    height: auto;
    padding: 1;
    margin: 0 1 1 0;
    background: $bg-elevated;
    border: none;
    text-align: center;
    content-align: center top;
}

.artist-tile:hover {
    background: $bg-hover;
    border-left: thick $accent-warning;
}

.artist-tile:focus {
    background: $bg-hover;
    border-left: thick $accent-warning;
    transition: border 150ms;
}

.artist-tile-cover {
    width: 24;
    height: 12;
    background: $bg-inset;
    border: solid $border-subtle;
    overflow: hidden;
    content-align: center middle;
    margin: 0 0 1 0;
}

.tile-name {
    color: $text-accent;
    text-style: bold;
    height: auto;
    max-height: 2;
    overflow: hidden;
    text-align: center;
}

.tile-meta {
    color: $text-muted;
    height: auto;
    text-align: center;
}

.tile-action {
    width: 1fr;
    min-width: 6;
    padding: 0 1;
    margin: 0;
    background: $bg-surface;
    border: solid $border-color;
}

.tile-action:hover {
    background: $accent-primary;
    border: solid $accent-primary;
}

.tile-action-dl {
    background: $bg-surface;
}

.tile-action-dl:hover {
    background: $accent-success;
    border: solid $accent-success;
}

.tile-actions-row {
    height: auto;
    width: 100%;
    margin-top: 1;
    align: center middle;
}

/* ---- Album grid ---- */
.album-grid {
    height: auto;
    width: 100%;
    padding: 0;
    overflow-x: auto;
}

.album-tile {
    width: 28;
    min-height: 18;
    height: auto;
    padding: 1;
    margin: 0 1 1 0;
    background: $bg-elevated;
    border: none;
    text-align: center;
    content-align: center top;
}

.album-tile:hover {
    background: $bg-hover;
    border-left: thick $accent-secondary;
}

.album-tile:focus {
    background: $bg-hover;
    border-left: thick $accent-secondary;
    transition: border 150ms;
}

.album-tile-cover {
    width: 24;
    height: 12;
    background: $bg-inset;
    border: solid $border-subtle;
    overflow: hidden;
    content-align: center middle;
    margin: 0 0 1 0;
}

/* ---- Compact track/playlist rows ---- */
.track-list {
    height: auto;
    width: 100%;
}

.compact-row {
    height: auto;
    max-height: 7;
    width: 100%;
    padding: 0 2;
    margin: 0 0 1 0;
    background: $bg-surface;
    border: none;
    align: left middle;
}

.compact-row:hover {
    background: $bg-hover;
}

.compact-row:focus {
    background: $bg-hover;
    border-left: thick $accent-primary;
    transition: border 150ms;
}

.row-cover {
    width: 10;
    height: 5;
    background: $bg-inset;
    border: solid $border-subtle;
    overflow: hidden;
    content-align: center middle;
    margin-right: 1;
}

.row-icon {
    width: 3;
    text-align: center;
    height: 1;
}

.row-info {
    width: 1fr;
    height: auto;
    padding: 0;
}

.row-title {
    color: $text-primary;
    height: 1;
}

.row-subtitle {
    color: $text-secondary;
    height: 1;
}

.row-platforms {
    width: auto;
    height: 1;
    margin: 0 1;
}

.row-duration {
    width: 6;
    text-align: right;
    height: 1;
}

.row-action {
    width: auto;
    min-width: 4;
    padding: 0;
    margin: 0;
    background: $bg-surface;
    border: solid $border-subtle;
    color: $text-muted;
}

.row-action:hover {
    color: $accent-primary;
    background: $bg-hover;
    border: solid $accent-primary;
}

.row-action-dl:hover {
    color: $accent-success;
    border: solid $accent-success;
}

/* ---- Card cover (generic, in tiles) ---- */
.card-cover {
    overflow: hidden;
    content-align: center middle;
}

/* ---- Empty states ---- */
#empty-state {
    height: auto;
    padding: 3;
    text-align: center;
    align: center middle;
}

.empty-state {
    height: auto;
    padding: 3;
    text-align: center;
}

.empty-message {
    color: $text-secondary;
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
}

.empty-hint {
    color: $text-muted;
    text-style: italic;
    text-align: center;
}

#no-results {
    height: auto;
    padding: 3;
    text-align: center;
    align: center middle;
}

/* ---- Load More buttons ---- */
.load-more-btn {
    width: 100%;
    margin: 1 0 0 0;
    padding: 0 2;
    background: $bg-surface;
    border: solid $border-color;
    color: $text-muted;
}

.load-more-btn:hover {
    background: $bg-hover;
    border: solid $accent-primary;
    color: $text-primary;
}

.load-more-btn:focus {
    background: $bg-hover;
    border: solid $accent-focus;
}


/* ==========================================================================
   7. DETAIL SCREENS — Shared hero, stat chips, two-column layout
   ========================================================================== */

/* ---- Hero sections ---- */
.hero-section {
    background: $bg-panel;
    padding: 2 3;
    margin-bottom: 2;
    border-bottom: solid $border-subtle;
}

#track-hero-content,
#album-hero-content,
#artist-hero-content,
#playlist-hero-content {
    height: auto;
    min-height: 10;
    align: left top;
}

/* ---- CoverArt widget ---- */
CoverArt {
    overflow: hidden;
}

CoverArt #cover-image {
    width: 1fr;
    height: 1fr;
}

.cover-placeholder-icon {
    content-align: center middle;
    width: 100%;
    height: 100%;
    color: $text-dim;
}

/* ---- Cover / Avatar placeholders ---- */
.cover-placeholder {
    width: 20;
    height: 10;
    background: $bg-inset;
    border: solid $border-subtle;
    content-align: center middle;
    margin-right: 2;
}

.cover-placeholder-large {
    width: 26;
    height: 13;
    background: $bg-inset;
    border: solid $border-subtle;
    content-align: center middle;
    margin-right: 2;
}

.avatar-placeholder {
    width: 16;
    height: 8;
    background: $bg-inset;
    border: solid $accent-primary;
    content-align: center middle;
    margin-right: 2;
}

/* ---- Info sections ---- */
#track-info,
#album-info,
#artist-info,
#playlist-info {
    width: 1fr;
}

/* Badges rows */
#track-badges,
#album-badges {
    height: auto;
    margin-bottom: 1;
}

/* Stats rows */
.stats-row {
    height: auto;
    margin: 1 0;
}

.stat-item {
    width: auto;
    margin-right: 3;
}

/* Genre row */
.genre-row {
    height: auto;
    margin: 1 0;
}

.genre-row .badge {
    margin-right: 1;
}

/* Actions row */
.actions-row {
    height: auto;
    margin-top: 1;
}

.actions-row Button {
    margin-right: 1;
}

/* Detail row (ISRC, Label, etc.) */
.detail-row {
    height: auto;
    margin: 0;
    color: $text-secondary;
}

/* Description text */
.description-text {
    color: $text-secondary;
    max-height: 4;
    overflow: hidden;
    margin: 1 0;
}

/* ---- Content grids ---- */
#track-content,
#album-content,
#artist-content,
#playlist-content {
    width: 100%;
    height: auto;
    min-height: 20;
    padding: 1 2;
}

/* Main column (left, 2/3 width) */
.main-column {
    width: 66%;
    padding-right: 2;
}

/* Sidebar column (right, 1/3 width) */
.sidebar-column {
    width: 34%;
    padding-left: 2;
    border-left: solid $border-subtle;
}

/* ---- Stats grid ---- */
.stats-grid {
    height: auto;
}

.stat-box {
    width: 1fr;
    text-align: center;
    padding: 1;
}

.stat-value {
    text-style: bold;
    color: $accent-primary;
}

.stat-label {
    color: $text-muted;
}

/* ---- Bio text ---- */
.bio-text {
    color: $text-secondary;
    max-height: 8;
    overflow: hidden;
}

/* ---- Detail containers ---- */
#track-container,
#album-container,
#artist-container,
#playlist-container {
    width: 100%;
    height: 100%;
    background: $bg-chassis;
}

/* ---- Info panel sections (legacy / shared) ---- */
.info-section {
    margin-bottom: 2;
}

.info-section-title {
    text-style: bold;
    color: $accent-primary;
    margin-bottom: 1;
    padding: 0 1;
}

.info-section-content {
    padding: 0 1;
}

.provider-item {
    height: 1;
    margin-bottom: 0;
}

.config-item {
    height: 1;
    margin-bottom: 0;
    color: $text-muted;
}

#quick-tips {
    padding: 0;
    color: $text-muted;
}

/* ---- Legacy card info styles ---- */
.card-info {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

.card-action {
    width: auto;
    height: auto;
    padding: 0;
}

.card-meta-row {
    height: auto;
    align: left middle;
    margin-bottom: 0;
}

/* ---- Entity card cover (small, used in detail views) ---- */
.card-cover-small {
    width: 14;
    height: 7;
    background: $bg-inset;
    border: solid $border-subtle;
}


/* ==========================================================================
   8. TRACK-SPECIFIC — Match bars, audio meters, lyrics panel
   ========================================================================== */

/* ---- Matches container ---- */
#matches-container {
    height: auto;
    min-height: 10;
}

#matches-table {
    height: auto;
    min-height: 8;
    max-height: 30;
}

/* ---- Tracks container ---- */
#tracks-container {
    height: auto;
    min-height: 10;
}

#tracks-table {
    height: auto;
    min-height: 8;
    max-height: 40;
}

/* ---- Top tracks container ---- */
#top-tracks-container {
    height: auto;
    min-height: 8;
}

#top-tracks-table {
    height: auto;
    min-height: 6;
    max-height: 20;
}

/* ---- Album tables ---- */
#albums-table-all,
#albums-table-albums,
#albums-table-singles,
#albums-table-eps {
    height: auto;
    min-height: 6;
    max-height: 20;
}

#albums-table-compilations {
    height: auto;
    min-height: 6;
    max-height: 20;
}

/* ---- Discography tabs ---- */
#discography-tabs {
    height: auto;
    min-height: 10;
}

/* ---- Audio features ---- */
.feature-row {
    height: auto;
    margin: 1 0;
    align: left middle;
}

.feature-label {
    width: 12;
    color: $text-secondary;
}

.feature-value {
    color: $text-primary;
    text-style: bold;
}

.feature-row ProgressBar {
    width: 1fr;
}

.feature-detail-value {
    color: $text-secondary;
    margin: 0 0 1 0;
}

/* ---- Lyrics ---- */
.lyrics-scroll {
    max-height: 20;
    background: $bg-inset;
    padding: 1;
    border: none;
}

.lyrics-text {
    color: $text-secondary;
}

/* ---- Card header row (inline selectors) ---- */
.card-header-row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.card-header-row .card-title {
    width: auto;
    margin-right: 2;
}

.card-header-row Select {
    width: 1fr;
}

/* ---- Inline match submission ---- */
#submit-match-form {
    height: auto;
    padding: 1;
}

#submit-match-form Input {
    margin: 1 0;
}

#submit-match-form Button {
    margin-top: 1;
}

/* ---- Technical info and rights cards ---- */
#technical-info-card,
#rights-info-card,
#copyright-card,
#created-by-card {
    height: auto;
}


/* ==========================================================================
   9. QUEUE SCREEN — Progress bar, status indicators, now-playing
   ========================================================================== */

#queue-container {
    padding: 1 2;
    height: 100%;
}

#queue-header {
    height: auto;
    min-height: 5;
    margin-bottom: 1;
    align: left middle;
    padding: 1 1;
    background: $bg-panel;
    border-bottom: solid $border-subtle;
}

#queue-title-block {
    width: 1fr;
}

#queue-title {
    text-style: bold;
    color: $accent-primary;
    width: auto;
}

#queue-stats {
    color: $text-muted;
}

#queue-actions {
    height: auto;
    align: right middle;
}

#queue-actions Button {
    min-width: 10;
}

#queue-content {
    height: 1fr;
    width: 100%;
    padding: 1 0;
}

#queue-main {
    width: 70%;
    padding-right: 1;
}

#queue-sidebar {
    width: 30%;
    padding-left: 1;
    border-left: solid $border-subtle;
}

#queue-table-container {
    height: 1fr;
    min-height: 10;
    background: $bg-surface;
    border: none;
}

#queue-table {
    width: 100%;
    height: 1fr;
    min-height: 10;
}

#queue-now-footer {
    dock: bottom;
    height: 5;
    width: 100%;
    padding: 0 1;
    background: $bg-panel;
    border-top: solid $border-subtle;
}

#queue-now-footer #queue-cover {
    width: 8;
    height: 4;
}

#queue-now-info {
    width: 1fr;
    padding: 0 1;
}

#queue-now-footer #current-download {
    height: 1;
    color: $text-primary;
}

#current-meta {
    width: auto;
    padding: 0 1;
}

#queue-summary {
    color: $text-secondary;
}

/* ---- Queue filter tabs ---- */
#queue-filter-tabs {
    height: auto;
    max-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    align: left middle;
}

#queue-filter-tabs Button {
    min-width: 10;
    margin-right: 1;
}

.queue-filter-active {
    background: $accent-primary;
    color: $text-primary;
    border: solid $accent-primary;
}

/* ---- Overall progress ---- */
#overall-progress-container {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

#overall-progress {
    width: 100%;
}

/* ---- Queue empty / complete ---- */
#queue-empty-state {
    text-align: center;
    padding: 3;
}

#queue-empty-state Button {
    margin-top: 2;
}

#queue-complete-notice {
    color: $accent-success;
    text-align: center;
    padding: 1;
}

/* ---- Download status colors ---- */
.dl-pending {
    color: $text-muted;
}

.dl-searching {
    color: $accent-warning;
}

.dl-downloading {
    color: $accent-primary;
}

.dl-converting {
    color: $accent-secondary;
}

.dl-embedding {
    color: $accent-secondary;
}

.dl-completed {
    color: $accent-success;
}

.dl-failed {
    color: $accent-error;
}

.dl-cancelled {
    color: $text-muted;
}


/* ==========================================================================
   10. SETTINGS SCREEN — Sidebar nav pattern (left nav 20 cols + right content)
   ========================================================================== */

#settings-container {
    padding: 1 2;
    width: 100%;
    height: 100%;
}

#settings-header {
    height: auto;
    min-height: 5;
    margin-bottom: 1;
    border-bottom: solid $border-subtle;
    padding-bottom: 1;
}

#settings-title {
    text-style: bold;
    color: $accent-primary;
}

#settings-subtitle {
    color: $text-secondary;
}

/* Settings groups */
.settings-group {
    background: $bg-surface;
    border: none;
    padding: 1 2;
    margin-bottom: 2;
    height: auto;
    width: 100%;
}

.settings-group Static {
    height: auto;
    width: 100%;
}

.settings-group Label {
    height: auto;
}

.settings-group Input {
    height: 3;
}

.settings-group Select {
    height: 3;
}

.settings-group Checkbox {
    height: auto;
}

.settings-group Horizontal {
    height: auto;
    width: 100%;
}

.settings-group Vertical {
    height: auto;
    width: 100%;
}

.settings-group-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.settings-group-icon {
    color: $accent-primary;
    width: 3;
}

.settings-group-title {
    text-style: bold;
    color: $text-accent;
    width: auto;
}

.settings-group-badge {
    margin-left: 2;
}

.settings-group-desc {
    color: $text-secondary;
    margin-bottom: 1;
}

/* Group title */
.group-title {
    text-style: bold;
    color: $accent-primary;
    margin-bottom: 1;
    height: auto;
    width: 100%;
}

.setting-row {
    height: auto;
    min-height: 3;
    align: left middle;
    margin: 1 0;
}

.setting-row Label {
    width: 25;
    color: $text-primary;
}

.setting-row Input {
    width: 1fr;
}

.setting-row Select {
    width: 1fr;
}

.setting-row Checkbox {
    width: 1fr;
}

.setting-label {
    width: 35%;
    color: $text-primary;
}

.setting-input {
    width: 65%;
}

.setting-hint {
    color: $text-muted;
    text-style: italic;
    padding: 0 1;
}

/* Help text */
.help-text {
    color: $text-muted;
    height: auto;
}

.section-desc {
    margin-bottom: 1;
}

/* Group header */
.group-header {
    height: auto;
    width: 100%;
    align: left middle;
}

/* Status badges */
.status-badge {
    margin-left: 2;
    height: auto;
}

/* ---- Credentials sections ---- */
.credentials-section {
    border: solid $accent-primary;
}

.cred-field-group {
    height: auto;
    margin: 1 0;
}

.cred-label-row {
    height: auto;
    width: 100%;
    align: left middle;
    margin-bottom: 1;
}

.cred-label {
    width: auto;
    color: $text-primary;
}

.toggle-visibility-btn {
    margin-left: 2;
    min-width: 8;
}

.cred-input {
    width: 100%;
    height: 3;
}

.cred-option-group {
    height: auto;
    margin: 1 0;
}

.option-hint {
    color: $text-muted;
    text-style: italic;
    height: auto;
}

.cred-help-link {
    color: $accent-secondary;
    height: auto;
    margin-top: 1;
}

/* Credential groups in settings */
.credentials-group {
    background: $bg-surface;
    border: solid $accent-primary;
    padding: 1 2;
    margin-bottom: 2;
}

.cred-group-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.cred-group-title {
    text-style: bold;
    color: $text-primary;
    width: auto;
}

.cred-group-status {
    margin-left: 2;
}

.cred-group-desc {
    color: $text-secondary;
    margin-bottom: 1;
}

.cred-row {
    margin: 1 0;
}

.cred-row-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.cred-row-label {
    text-style: bold;
    color: $text-primary;
    width: auto;
}

.visibility-btn {
    min-width: 8;
    height: 1;
    margin-left: 2;
}

.cred-row-input {
    width: 100%;
}

.cred-option {
    margin: 1 0;
    padding: 1 0;
}

.cred-option-hint {
    color: $text-muted;
    text-style: italic;
    padding-left: 4;
}

.cred-help {
    color: $accent-secondary;
    text-style: italic;
    padding: 1 0;
}

/* Settings actions */
#settings-actions {
    height: 5;
    margin-top: 2;
    padding-top: 1;
    border-top: solid $border-subtle;
    align: center middle;
}

#settings-actions Button {
    margin: 0 2;
    min-width: 16;
}

/* Matching thresholds */
#matching-thresholds {
    height: auto;
    width: 100%;
}

/* Export/Import buttons */
.settings-action-btn {
    margin: 0 1;
    min-width: 14;
}


/* ==========================================================================
   11. MODALS — Login, submit match, report overlays
   ========================================================================== */

/* ---- Login screen ---- */
#login-container {
    width: 100%;
    height: 100%;
    align: center middle;
    background: $bg-chassis;
}

#login-form {
    width: 60;
    height: auto;
    padding: 2 4;
    background: $bg-surface;
    border: solid $border-subtle;
}

#login-form Input {
    margin-bottom: 1;
}

#login-btn {
    width: 100%;
    margin-top: 1;
}

/* ---- Submit match screen ---- */
#submit-match-container {
    padding: 2;
}

#submit-match-actions {
    height: auto;
    margin-top: 1;
}

#submit-match-actions Button {
    margin-right: 1;
}

/* ---- Report screen ---- */
#report-container {
    padding: 2;
}

#report-actions {
    height: auto;
    margin-top: 1;
}

#report-actions Button {
    margin-right: 1;
}


/* ==========================================================================
   12. ADMIN — Dashboard stat grid, tables
   ========================================================================== */

#admin-container {
    padding: 1 2;
    width: 100%;
    height: 100%;
}

#admin-stats-grid {
    height: auto;
    margin-bottom: 2;
}

#admin-stats-grid .stat-box {
    background: $bg-surface;
    margin-right: 1;
    padding: 1;
}

.admin-actions-row {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

.admin-actions-row Button {
    margin-right: 1;
}


/* ==========================================================================
   13. ONBOARDING — Step progress, feature grid
   ========================================================================== */

#onboarding-container {
    width: 100%;
    height: 100%;
    background: $bg-chassis;
}

/* Progress header */
#onboarding-header {
    dock: top;
    height: 5;
    background: $bg-panel;
    border-bottom: solid $border-subtle;
    padding: 1 2;
}

#progress-steps {
    height: auto;
    align: center middle;
}

.step-item {
    width: auto;
    padding: 0 2;
    text-align: center;
}

.step-number {
    text-style: bold;
}

.step-number-active {
    color: $accent-primary;
}

.step-number-complete {
    color: $accent-success;
}

.step-number-pending {
    color: $text-muted;
}

.step-connector {
    width: 4;
    color: $border-color;
}

.step-connector-complete {
    color: $accent-success;
}

#step-title {
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

/* Content area */
#onboarding-content {
    height: 1fr;
    padding: 2 4;
}

.onboarding-step {
    width: 100%;
    max-width: 80;
    margin: 0 2;
}

/* Welcome step */
#welcome-content {
    text-align: center;
}

#welcome-logo {
    color: $accent-primary;
    text-style: bold;
    padding: 1;
}

#welcome-title {
    text-style: bold;
    color: $text-accent;
    padding: 1;
}

#welcome-subtitle {
    color: $text-secondary;
    padding: 1;
}

.feature-grid {
    margin: 2 0;
}

.feature-item {
    margin: 1 0;
    padding: 1 2;
    background: $bg-surface;
    border: none;
}

.feature-icon {
    color: $accent-primary;
    width: 4;
}

.feature-text {
    width: 1fr;
}

.feature-title {
    text-style: bold;
    color: $text-accent;
}

.feature-desc {
    color: $text-secondary;
}

/* Config cards */
.config-card {
    background: $bg-surface;
    border: none;
    padding: 1 2;
    margin-bottom: 2;
}

.config-card-header {
    height: auto;
    margin-bottom: 1;
}

.config-card-icon {
    color: $accent-primary;
    width: 3;
}

.config-card-title {
    text-style: bold;
    color: $text-accent;
}

.config-card-desc {
    color: $text-secondary;
    margin-bottom: 1;
}

.config-input {
    width: 100%;
    margin-top: 1;
}

.config-select {
    width: 100%;
    margin-top: 1;
}

/* Credentials card */
.credentials-card {
    background: $bg-surface;
    border: solid $accent-primary;
    padding: 1 2;
    margin: 1 0;
}

.credentials-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.credentials-title {
    text-style: bold;
    color: $text-primary;
    width: auto;
}

.credentials-badge {
    margin-left: 2;
    background: #332200;
    color: $accent-warning;
    padding: 0 1;
    text-style: bold;
}

.cred-status-bar {
    height: 3;
    margin: 1 0;
    padding: 1;
    text-align: center;
    background: $bg-elevated;
    border: solid $border-color;
}

.cred-status-bar.configured {
    background: #003322;
    border: solid $accent-success;
}

.cred-status-bar.partial {
    background: #332200;
    border: solid $accent-warning;
}

.cred-field {
    margin: 1 0;
}

.cred-field-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.cred-field-label {
    text-style: bold;
    color: $text-primary;
    width: auto;
}

.toggle-btn {
    min-width: 8;
    height: 1;
    margin-left: 2;
    padding: 0 1;
}

.auth-section {
    margin-top: 1;
    padding-top: 1;
    border-top: solid $border-subtle;
}

.auth-hint {
    color: $text-muted;
    text-style: italic;
    padding-left: 4;
}

/* Instructions */
.instructions-card {
    margin-top: 2;
    background: $bg-elevated;
    border: none;
    padding: 1;
}

.instructions-btn {
    width: 100%;
    background: transparent;
    border: none;
    color: $accent-secondary;
}

#instructions-content {
    margin-top: 1;
    padding: 1;
}

.skip-note {
    color: $text-muted;
    text-style: italic;
    text-align: center;
    margin-top: 2;
}

/* Complete step */
#complete-content {
    text-align: center;
}

#complete-icon {
    color: $accent-success;
    padding: 1;
}

#complete-title {
    text-style: bold;
    color: $text-accent;
    padding: 1;
}

.tips-grid {
    margin: 2 0;
}

.tip-item {
    margin: 1 0;
    padding: 1;
    text-align: left;
}

.tip-key {
    color: $accent-primary;
    text-style: bold;
    width: 8;
}

.tip-desc {
    color: $text-primary;
}

/* Navigation */
#onboarding-nav {
    dock: bottom;
    height: 5;
    background: $bg-panel;
    border-top: solid $border-subtle;
    padding: 1 4;
    align: center middle;
}

#onboarding-nav Button {
    margin: 0 2;
    min-width: 14;
}


/* ==========================================================================
   14. ACCOUNT SCREEN
   ========================================================================== */

#account-scroll {
    padding: 1 2;
    width: 100%;
    height: 100%;
}

#not-logged-in {
    text-align: center;
    padding: 3;
}

#not-logged-in Button {
    margin-top: 2;
}

.account-field {
    color: $text-secondary;
    margin: 0 0 1 0;
}

.reputation-score {
    text-style: bold;
    color: $accent-primary;
    text-align: center;
    padding: 1;
}

.danger-zone {
    border: solid $accent-error;
}

#delete-actions {
    height: auto;
    margin-top: 1;
}

#delete-actions Button {
    margin-right: 1;
}

/* ---- Artist screen extras ---- */
#expand-bio-btn {
    min-width: 12;
    margin-top: 1;
}

#related-artists-content {
    height: auto;
}

.related-artist-link {
    color: $accent-secondary;
    padding: 0 1;
    margin: 0 0 1 0;
}


/* ==========================================================================
   15. RESPONSIVE / TEXT UTILITIES
   ========================================================================== */

.text-muted {
    color: $text-muted;
}

.text-center {
    text-align: center;
}

.text-sm {
    height: auto;
}

.mb-2 {
    margin-bottom: 2;
}

.mt-2 {
    margin-top: 2;
}

.w-full {
    width: 100%;
}
