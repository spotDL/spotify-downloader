[importlinter]
root_packages =
    spotdl_core
    spotdl_server
    spotdl_cli
# Required so the forbidden contracts below can name external packages
# (``sqlalchemy``, ``fastapi``) as forbidden import targets.
include_external_packages = True

[importlinter:contract:layers]
name = Dependency direction: core <- server <- cli
type = layers
layers =
    spotdl_cli
    spotdl_server
    spotdl_core

[importlinter:contract:no_cli_core]
name = CLI must not import core directly (server API only)
type = forbidden
source_modules =
    spotdl_cli
forbidden_modules =
    spotdl_core
# The CLI's embedded transport imports ``spotdl_server.app`` (an allowed
# cli -> server edge per the layers contract), which in turn imports core — an
# unavoidable *indirect* reach. This contract forbids only *direct* cli -> core
# imports (the CLI using core types itself), matching its name ("directly") and
# spec §3 (apps/server is the sole direct consumer of packages/core).
allow_indirect_imports = True

# --------------------------------------------------------------------------
# Intra-server layering (Plan 5 §6, Task 12). Routers are a thin HTTP shell;
# services orchestrate DTOs; repositories are the sole ORM holders; db defines
# the schema. ``api.deps``/``api.errors``/``api.schemas``/``api.middleware`` are
# HTTP glue that sit *outside* these four layers by design — they may import both
# FastAPI and services (``api.middleware`` also imports ``ratelimit``/``auth``
# helpers) and are therefore not named as layers. ``auth``/``ratelimit``/
# ``policies`` are leaf utility packages *below* services (see the leaf contract).
# --------------------------------------------------------------------------

[importlinter:contract:server_layers]
name = Server layering: routers -> services -> repositories -> db
type = layers
containers =
    spotdl_server
layers =
    api.routers
    services
    repositories
    db

[importlinter:contract:routers_no_orm]
name = Routers must not import SQLAlchemy/ORM
type = forbidden
source_modules =
    spotdl_server.api.routers
forbidden_modules =
    sqlalchemy
    spotdl_server.db.models
# Routers reach services only through ``api.deps`` (HTTP glue), and ``deps.py``
# legitimately imports SQLAlchemy to compose the request-scoped session. That is
# an *indirect* routers -> deps -> sqlalchemy edge; this contract forbids only a
# *direct* ORM import from a router (the real layering violation). ``ast``-level
# direct-import enforcement lives in ``tests/test_layering.py``.
allow_indirect_imports = True

[importlinter:contract:services_no_fastapi]
name = Services must not import FastAPI
type = forbidden
source_modules =
    spotdl_server.services
forbidden_modules =
    fastapi

[importlinter:contract:leaf_utils_are_leaves]
name = Leaf utility packages (auth/ratelimit/policies) import no framework/service/repo layer
type = forbidden
source_modules =
    spotdl_server.auth
    spotdl_server.ratelimit
    spotdl_server.policies
forbidden_modules =
    fastapi
    spotdl_server.services
    spotdl_server.repositories
# ``auth``/``ratelimit``/``policies`` sit *below* services and are importable by
# both ``services`` and ``api`` without a layering violation. They speak only pure
# Python + narrow external deps: ``ratelimit.redis`` importing ``redis`` and
# ``auth.oauth_providers`` importing ``httpx`` are both fine (not named here).
# The source-level AST guard in ``tests/test_layering.py`` additionally forbids a
# direct ``sqlalchemy`` import from any leaf-package file.
