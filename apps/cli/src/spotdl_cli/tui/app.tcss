/* spotDL TUI — the one stylesheet (CONTRACT §2: a single .tcss token system).
 *
 * Theme-neutral: colours come from Textual's design tokens ($panel, $surface,
 * $accent, $primary, $boost, $text-muted, $success, $warning, $error) so the app
 * follows the active light/dark theme. This sheet is the shared vocabulary — the
 * app shell layout, the nav rail, bordered panels with titles, zebra tables,
 * buttons, and the reusable empty/loading/error/stat patterns — that every screen
 * composes on. Screens add only their own structural rules below the shared block.
 */

/* ------------------------------------------------------------------ shell §1 */

Screen {
    layout: vertical;
}

#app-body {
    width: 100%;
    height: 1fr;
}

#content-region {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

StatusBar {
    height: 1;
    width: 100%;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    content-align: left middle;
}

Footer {
    background: $panel;
}

/* ---------------------------------------------------------------- nav rail §1 */

NavRail {
    width: 22;
    height: 100%;
    layout: vertical;
    background: $panel;
    padding: 1 1;
}

.nav-title {
    text-style: bold;
    color: $accent;
    padding: 0 1 1 1;
}

.nav-entry {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

.nav-entry:hover {
    background: $boost;
    color: $text;
}

.nav-entry--active {
    background: $boost;
    color: $accent;
    text-style: bold;
}

.nav-spacer {
    height: 1fr;
}

.nav-conn {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

/* --------------------------------------------------------------- panels §2 */

.panel {
    border: round $primary 30%;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
}

.panel:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

/* Every table fills its pane, stripes, and shows an accent cursor row. */
DataTable {
    height: 1fr;
}

DataTable > .datatable--header {
    text-style: bold;
    color: $text-muted;
}

DataTable > .datatable--cursor {
    background: $accent;
}

/* Consistent button spacing; primary leftmost is a compose-order convention. */
Button {
    margin: 0 1 0 0;
}

/* ------------------------------------------------- reusable pane patterns §2 */

.empty-state {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

.loading-pane {
    width: 100%;
    height: 1fr;
    align: center middle;
}

.loading-label {
    color: $text-muted;
    padding: 1 0 0 0;
}

.error-pane {
    height: auto;
    padding: 1 1;
    color: $error;
}

.stat-card {
    border: round $primary 30%;
    border-title-color: $text-muted;
    width: 1fr;
    min-width: 16;
    height: auto;
    padding: 1 1;
    text-style: bold;
    content-align: center middle;
}

/* ---------------------------------------------------------- connect screen §3 */

.connect-status {
    height: auto;
    border: round $primary 30%;
    border-title-color: $text-muted;
    padding: 1 1;
    margin: 0 0 1 0;
}

#connect-cards {
    height: 1fr;
    layout: horizontal;
}

.connect-card {
    width: 1fr;
    height: auto;
    border: round $primary 30%;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 1 1;
    margin: 0 1 0 0;
}

.connect-card:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

.card-blurb {
    height: auto;
    color: $text-muted;
    padding: 0 0 1 0;
}

.card-error {
    height: auto;
    color: $error;
}

#connect-actions {
    height: auto;
    padding: 1 0 0 0;
}

/* ------------------------------------------------------------- help modal §4 */

HelpScreen {
    align: center middle;
}

#help-panel {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

.help-body {
    height: auto;
}

/* ------------------------------------------------ per-screen structural rules */

/* Placeholder stand-in (unbuilt section/entity). */
.placeholder {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

/* Settings: a scrolling stack of labelled controls + an inline validation line. */
#settings-form {
    height: 1fr;
    padding: 0 1;
}

.settings-label {
    color: $text-muted;
    padding: 1 0 0 0;
}

.settings-error {
    height: auto;
    padding: 0 1;
    color: $error;
}

/* Auth: identity line + login form. */
#auth-status {
    padding: 1 1 0 1;
    color: $text-muted;
}

.auth-offline {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#auth-buttons {
    height: auto;
    padding: 1 1;
}

#auth-buttons Button {
    margin: 0 1 0 0;
}

/* Admin: stats summary line above the reports table. */
.admin-stats {
    height: auto;
    padding: 1 1;
    color: $text-muted;
}

/* Shared gauge accents (track matches, queue progress). */
.gauge--bar {
    color: $accent;
}

.gauge--full {
    color: $success;
}

/* Library screen: a batch list left, its files table + save-file heading right,
 * collapsing to a stack under 110 cols (§4/§1). */
#library-body {
    height: 1fr;
}

#library-main {
    height: 1fr;
    layout: horizontal;
}

#library-main.narrow {
    layout: vertical;
}

#library-batches {
    width: 34;
    height: 1fr;
    margin: 1 1 0 0;
    background: $panel;
}

#library-detail {
    width: 1fr;
    height: 1fr;
    margin: 1 0 0 0;
}

#library-main.narrow #library-batches {
    width: 1fr;
    height: auto;
    max-height: 40%;
}

#library-main.narrow #library-detail {
    width: 1fr;
}

.library-batch-heading {
    height: auto;
    color: $text-muted;
    padding: 0 1 1 1;
}

/* Queue screen: enqueue input, a bordered summary strip (overall bar + chips),
 * the batch-grouped jobs table, and a one-row footer of key actions (§4). */
#enqueue-input {
    margin: 0 0 1 0;
}

#queue-summary {
    height: auto;
    color: $text;
    margin: 0 0 1 0;
}

#queue-table {
    height: 1fr;
}

#queue-actions {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

/* Track screen: the header card, the match column, and the lyrics pane. */
.hidden {
    display: none;
}

/* Search screen: bordered input, filter chips, results panel with banners. */
#search-box {
    height: auto;
    margin: 0 0 1 0;
}

#search-box Input {
    border: none;
    background: $surface;
}

#filter-chips {
    height: 1;
    color: $text-muted;
    padding: 0 1 1 1;
}

#results-panel {
    height: 1fr;
}

#search-results {
    height: 1fr;
}

.results-empty {
    width: 100%;
    height: 1fr;
    color: $text-muted;
    padding: 1 1;
}

.banner {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    text-style: bold;
}

.banner--warn {
    color: $error;
}

.banner--degraded {
    color: $warning;
}

/* Track screen: the accent-bordered header card, matches column, lyrics pane. */
#track-header {
    height: auto;
    border-left: thick $accent;
    margin: 0 0 1 0;
}

#card-slot {
    height: auto;
}

.vote-cta {
    width: auto;
    margin: 1 0 0 0;
    background: $boost;
    color: $warning;
}

#track-actions {
    height: auto;
    padding: 1 0 0 0;
}

#track-body {
    layout: horizontal;
    height: 1fr;
}

#track-body.stacked {
    layout: vertical;
}

#matches {
    width: 1fr;
}

#lyrics-slot {
    width: 40;
    height: 1fr;
}

#track-body.stacked #lyrics-slot {
    width: 1fr;
    height: 1fr;
}

/* Header card for entity screens (track + collection): a bordered card with an
 * accent left bar and the kind in its border title (contract §4). */
EntityCard {
    height: auto;
    border: round $primary 30%;
    border-left: thick $accent;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
    color: $text;
}

/* Collection screen: header card over a tracks table + a fixed side panel that
 * collapses under the top card when the terminal narrows (contract §4/§1). */
#collection-body {
    height: 1fr;
}

#collection-main {
    height: 1fr;
    layout: horizontal;
}

#collection-main.narrow {
    layout: vertical;
}

#track-table {
    width: 1fr;
    height: 1fr;
    margin: 1 1 0 0;
}

#collection-side {
    width: 32;
    height: 1fr;
    margin: 1 0 0 0;
}

#collection-main.narrow #track-table {
    width: 1fr;
    height: 1fr;
}

#collection-main.narrow #collection-side {
    width: 1fr;
    height: auto;
}

#collection-side Button {
    width: 100%;
    margin: 1 0 0 0;
}

.collection-meta {
    height: auto;
    color: $text;
}

.collection-note {
    height: auto;
    color: $text-muted;
    margin: 1 0 0 0;
}

MatchGauge {
    height: auto;
    padding: 0 1;
}

MatchGauge:focus {
    background: $boost;
}

LyricsPane {
    height: 1fr;
    border: round $primary 30%;
    border-title-color: $text-muted;
    border-subtitle-color: $text-muted;
    padding: 0 1;
    color: $text-muted;
}

LyricsPane:focus {
    border: round $accent;
    border-title-color: $accent;
}
