/* spotDL TUI — the one stylesheet (CONTRACT B: a single .tcss).
 *
 * Theme-neutral: colours come from Textual's design tokens ($panel, $accent,
 * $boost, $text-muted) so the app follows the active light/dark theme instead of
 * hard-coding a palette. Layout tokens + shared accents (status bar, footer,
 * gauges, tables) live here; screens add only their own structural rules. */

Screen {
    layout: vertical;
}

StatusBar {
    dock: top;
    height: 1;
    width: 100%;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    content-align: left middle;
}

Footer {
    background: $panel;
}

/* Section/entity content sits between the docked status bar and footer. */
.placeholder {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

.help-body {
    padding: 1 2;
}

/* Settings: a scrolling stack of labelled controls + an inline validation line. */
#settings-form {
    height: 1fr;
    padding: 0 1;
}

.settings-label {
    color: $text-muted;
    padding: 1 0 0 0;
}

.settings-error {
    height: auto;
    padding: 0 1;
    color: $error;
}

/* Auth: identity line + login form. */
#auth-status {
    padding: 1 1 0 1;
    color: $text-muted;
}

.auth-offline {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#auth-buttons {
    height: auto;
    padding: 1 1;
}

#auth-buttons Button {
    margin: 0 1 0 0;
}

/* Admin: stats summary line above the reports table. */
.admin-stats {
    height: auto;
    padding: 1 1;
    color: $text-muted;
}

/* Shared accents later screens lean on (Task 6 gauges, Task 7/8 tables). */
DataTable {
    height: 1fr;
}

DataTable > .datatable--cursor {
    background: $accent;
}

.gauge--bar {
    color: $accent;
}

.gauge--full {
    color: $success;
}

/* Track screen (Task 6): the header card, the match column, and the lyrics pane. */
.hidden {
    display: none;
}

EntityCard {
    padding: 1 1 0 1;
    color: $text;
}

MatchGauge {
    height: auto;
    padding: 0 1;
}

MatchGauge:focus {
    background: $boost;
}

LyricsPane {
    height: auto;
    padding: 1;
    color: $text-muted;
}
