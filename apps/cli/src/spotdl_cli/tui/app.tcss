/* spotDL TUI — the one stylesheet (CONTRACT §2: a single .tcss token system).
 *
 * Theme-neutral: colours come from Textual's design tokens ($panel, $surface,
 * $accent, $primary, $boost, $text-muted, $success, $warning, $error) so the app
 * follows the active light/dark theme. This sheet is the shared vocabulary — the
 * app shell layout, the nav rail, bordered panels with titles, zebra tables,
 * buttons, and the reusable empty/loading/error/stat patterns — that every screen
 * composes on. Screens add only their own structural rules below the shared block.
 */

/* ------------------------------------------------------------------ shell §1 */

Screen {
    layout: vertical;
}

#app-body {
    width: 100%;
    height: 1fr;
}

#content-region {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

StatusBar {
    height: 1;
    width: 100%;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    content-align: left middle;
}

Footer {
    background: $panel;
}

/* ---------------------------------------------------------------- nav rail §1 */

NavRail {
    width: 22;
    height: 100%;
    layout: vertical;
    background: $panel;
    padding: 1 1;
}

.nav-title {
    text-style: bold;
    color: $accent;
    padding: 0 1 1 1;
}

.nav-entry {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

.nav-entry:hover {
    background: $boost;
    color: $text;
}

.nav-entry--active {
    background: $boost;
    color: $accent;
    text-style: bold;
}

.nav-spacer {
    height: 1fr;
}

.nav-conn {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

/* --------------------------------------------------------------- panels §2 */

.panel {
    border: round $primary 30%;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
}

.panel:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

/* Every table fills its pane, stripes, and shows an accent cursor row. */
DataTable {
    height: 1fr;
}

DataTable > .datatable--header {
    text-style: bold;
    color: $text-muted;
}

DataTable > .datatable--cursor {
    background: $accent;
}

/* Consistent button spacing; primary leftmost is a compose-order convention. */
Button {
    margin: 0 1 0 0;
}

/* ------------------------------------------------- reusable pane patterns §2 */

.empty-state {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

.loading-pane {
    width: 100%;
    height: 1fr;
    align: center middle;
}

.loading-label {
    color: $text-muted;
    padding: 1 0 0 0;
}

.error-pane {
    height: auto;
    padding: 1 1;
    color: $error;
}

.stat-card {
    border: round $primary 30%;
    border-title-color: $text-muted;
    width: 1fr;
    min-width: 16;
    height: auto;
    padding: 1 1;
    text-style: bold;
    content-align: center middle;
}

/* ---------------------------------------------------------- connect screen §3 */

.connect-status {
    height: auto;
    border: round $primary 30%;
    border-title-color: $text-muted;
    padding: 1 1;
    margin: 0 0 1 0;
}

#connect-cards {
    height: 1fr;
    layout: horizontal;
}

.connect-card {
    width: 1fr;
    height: auto;
    border: round $primary 30%;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 1 1;
    margin: 0 1 0 0;
}

.connect-card:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

.card-blurb {
    height: auto;
    color: $text-muted;
    padding: 0 0 1 0;
}

.card-error {
    height: auto;
    color: $error;
}

#connect-actions {
    height: auto;
    padding: 1 0 0 0;
}

/* ------------------------------------------------------------- help modal §4 */

HelpScreen {
    align: center middle;
}

#help-panel {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

.help-body {
    height: auto;
}

/* ------------------------------------------------ per-screen structural rules */

/* Placeholder stand-in (unbuilt section/entity). */
.placeholder {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

/* Settings: bordered sections of aligned label+control rows + a dirty-state footer. */
#settings-form {
    height: 1fr;
    padding: 0 1;
}

.form-section {
    height: auto;
    margin: 0 0 1 0;
    padding: 1 1;
}

.form-row {
    height: auto;
    align: left middle;
}

.form-label {
    width: 22;
    color: $text-muted;
    padding: 0 1 0 0;
    content-align: left middle;
}

.form-row Input,
.form-row Select {
    width: 1fr;
}

.field-error {
    height: auto;
    padding: 0 0 0 22;
    color: $error;
}

.settings-footer {
    height: auto;
    padding: 1 1;
    color: $text-muted;
}

/* Account: a single centred card, ≤70 cols, that swaps signed-in / signed-out. */
#auth-slot {
    width: 100%;
    height: 1fr;
    align: center middle;
}

.auth-card {
    width: 70;
    max-width: 100%;
    height: auto;
    padding: 1 2;
}

.auth-blurb {
    height: auto;
    color: $text-muted;
    padding: 0 0 1 0;
}

.auth-note {
    height: auto;
    color: $text-muted;
    text-style: italic;
    padding: 1 0 0 0;
}

#auth-status {
    height: auto;
    padding: 0 0 1 0;
    text-style: bold;
}

.auth-pat {
    height: auto;
    color: $text-muted;
    padding: 0 0 1 0;
}

.auth-offline {
    width: 70;
    max-width: 100%;
    height: auto;
    border: round $primary 30%;
    padding: 2 2;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

#auth-buttons,
#auth-pat-actions {
    height: auto;
    padding: 0 0 1 0;
}

/* Admin: a tabbed console — the stat-card grid, reports queue, and user roster. */
#admin-stats-grid {
    height: auto;
    padding: 1 0;
}

#admin-stats-grid .stat-card {
    margin: 0 1 0 0;
}

#admin-users-nav {
    height: auto;
    align: left middle;
    padding: 1 0 0 0;
}

.users-count {
    width: 1fr;
    color: $text-muted;
    content-align: center middle;
}

/* The optional-note prompt modal for approving / rejecting a report. */
NotePromptModal {
    align: center middle;
}

#note-panel {
    width: 60;
    max-width: 90%;
    height: auto;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

.note-prompt {
    height: auto;
    padding: 0 0 1 0;
}

#note-actions {
    height: auto;
    padding: 1 0 0 0;
}

/* Shared gauge accents (track matches, queue progress). */
.gauge--bar {
    color: $accent;
}

.gauge--full {
    color: $success;
}

/* Track screen: the header card, the match column, and the lyrics pane. */
.hidden {
    display: none;
}

EntityCard {
    padding: 1 1 0 1;
    color: $text;
}

MatchGauge {
    height: auto;
    padding: 0 1;
}

MatchGauge:focus {
    background: $boost;
}

LyricsPane {
    height: auto;
    padding: 1;
    color: $text-muted;
}
