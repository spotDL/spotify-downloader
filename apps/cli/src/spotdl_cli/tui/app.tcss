/* spotDL TUI — the one stylesheet (CONTRACT §2: a single .tcss token system).
 *
 * "Control Room" identity: broadcast-console precision — blue-ink black surfaces,
 * flat panels with hairline 1-cell borders, one phosphor-amber accent for
 * focus/active/meters, and segmented LED meters (▰▱) wherever progress or quality
 * appears. Colours come only through Textual's design tokens ($panel, $surface,
 * $accent, $primary, $boost, $text-muted, $success, $warning, $error) plus the
 * theme's extra $border/$primary-ink variables, so the palette lives in one place
 * (tui/theme.py, mirrored hex-for-hex from apps/web/src/index.css). This sheet is
 * the shared vocabulary — the app shell layout, the nav rail, bordered panels with
 * titles, zebra tables, buttons, and the reusable empty/loading/error/stat
 * patterns — that every screen composes on. Screens add only their own structural
 * rules below the shared block.
 */

/* ------------------------------------------------------------------ shell §1 */

Screen {
    layout: vertical;
}

#app-body {
    width: 100%;
    height: 1fr;
}

#content-region {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

StatusBar {
    height: 1;
    width: 100%;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    content-align: left middle;
}

Footer {
    background: $panel;
}

/* ---------------------------------------------------------------- nav rail §1 */

NavRail {
    width: 22;
    height: 100%;
    layout: vertical;
    background: $panel;
    padding: 1 1;
}

.nav-title {
    text-style: bold;
    color: $accent;
    padding: 0 1 1 2;
}

/* Rows carry a channel-bar gutter that stays the panel tone until active/hovered,
 * so lighting one amber never shifts the label — broadcast-console selection. */
.nav-entry {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    border-left: thick $panel;
}

.nav-entry:hover {
    background: $boost;
    color: $text;
    border-left: thick $border;
}

.nav-entry--active {
    background: $boost;
    color: $accent;
    text-style: bold;
    border-left: thick $accent;
}

.nav-spacer {
    height: 1fr;
}

.nav-conn {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

/* --------------------------------------------------------------- panels §2 */

.panel {
    border: solid $border;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
}

.panel:focus-within {
    border: solid $accent;
    border-title-color: $accent;
}

/* Every table fills its pane, stripes, and shows an amber cursor row with dark
 * ink — the Control Room readout. Headers read as quiet faint labels. */
DataTable {
    height: 1fr;
}

DataTable > .datatable--header {
    text-style: bold;
    color: $text-muted;
    background: $panel;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: auto 90%;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $boost;
}

/* Consistent button spacing; primary leftmost is a compose-order convention. */
Button {
    margin: 0 1 0 0;
}

/* ------------------------------------------------- reusable pane patterns §2 */

.empty-state {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

.loading-pane {
    width: 100%;
    height: 1fr;
    align: center middle;
}

.loading-label {
    color: $text-muted;
    padding: 1 0 0 0;
}

.error-pane {
    height: auto;
    padding: 1 1;
    color: $error;
}

.stat-card {
    border: solid $border;
    border-title-color: $text-muted;
    width: 1fr;
    min-width: 16;
    height: auto;
    padding: 1 1;
    text-style: bold;
    content-align: center middle;
}

/* ---------------------------------------------------------- connect screen §3 */

.connect-status {
    height: auto;
    border: solid $border;
    border-title-color: $text-muted;
    padding: 1 1;
    margin: 0 0 1 0;
}

#connect-cards {
    height: 1fr;
    layout: horizontal;
}

.connect-card {
    width: 1fr;
    height: auto;
    border: solid $border;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 1 1;
    margin: 0 1 0 0;
}

.connect-card:focus-within {
    border: solid $accent;
    border-title-color: $accent;
}

.card-blurb {
    height: auto;
    color: $text-muted;
    padding: 0 0 1 0;
}

.card-error {
    height: auto;
    color: $error;
}

#connect-actions {
    height: auto;
    padding: 1 0 0 0;
}

/* ------------------------------------------------------------- help modal §4 */

HelpScreen {
    align: center middle;
}

#help-panel {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: solid $accent;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

.help-body {
    height: auto;
}

/* ------------------------------------------------ per-screen structural rules */

/* Placeholder stand-in (unbuilt section/entity). */
.placeholder {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

/* Settings: bordered sections of aligned label+control rows + a dirty-state footer. */
#settings-form {
    height: 1fr;
    padding: 0 1;
}

.form-section {
    height: auto;
    margin: 0 0 1 0;
    padding: 1 1;
}

.form-row {
    height: auto;
    align: left middle;
}

.form-label {
    width: 22;
    color: $text-muted;
    padding: 0 1 0 0;
    content-align: left middle;
}

.form-row Input,
.form-row Select {
    width: 1fr;
}

.field-error {
    height: auto;
    padding: 0 0 0 22;
    color: $error;
}

.settings-footer {
    height: auto;
    padding: 1 1;
    color: $text-muted;
}

/* Account: a single centred card, ≤70 cols, that swaps signed-in / signed-out. */
#auth-slot {
    width: 100%;
    height: 1fr;
    align: center middle;
}

.auth-card {
    width: 70;
    max-width: 100%;
    height: auto;
    padding: 1 2;
}

.auth-blurb {
    height: auto;
    color: $text-muted;
    padding: 0 0 1 0;
}

.auth-note {
    height: auto;
    color: $text-muted;
    text-style: italic;
    padding: 1 0 0 0;
}

#auth-status {
    height: auto;
    padding: 0 0 1 0;
    text-style: bold;
}

.auth-pat {
    height: auto;
    color: $text-muted;
    padding: 0 0 1 0;
}

.auth-offline {
    width: 70;
    max-width: 100%;
    height: auto;
    border: solid $border;
    padding: 2 2;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

#auth-buttons,
#auth-pat-actions {
    height: auto;
    padding: 0 0 1 0;
}

/* Admin: a tabbed console — the stat-card grid, reports queue, and user roster. */
#admin-stats-grid {
    height: auto;
    padding: 1 0;
}

#admin-stats-grid .stat-card {
    margin: 0 1 0 0;
}

#admin-users-nav {
    height: auto;
    align: left middle;
    padding: 1 0 0 0;
}

.users-count {
    width: 1fr;
    color: $text-muted;
    content-align: center middle;
}

/* The optional-note prompt modal for approving / rejecting a report. */
NotePromptModal {
    align: center middle;
}

#note-panel {
    width: 60;
    max-width: 90%;
    height: auto;
    border: solid $accent;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

.note-prompt {
    height: auto;
    padding: 0 0 1 0;
}

#note-actions {
    height: auto;
    padding: 1 0 0 0;
}

/* Shared gauge accents (track matches, queue progress). */
.gauge--bar {
    color: $accent;
}

.gauge--full {
    color: $success;
}

/* Library screen: a batch list left, its files table + save-file heading right,
 * collapsing to a stack under 110 cols (§4/§1). */
#library-body {
    height: 1fr;
}

#library-main {
    height: 1fr;
    layout: horizontal;
}

#library-main.narrow {
    layout: vertical;
}

#library-batches {
    width: 34;
    height: 1fr;
    margin: 1 1 0 0;
    background: $panel;
}

#library-detail {
    width: 1fr;
    height: 1fr;
    margin: 1 0 0 0;
}

#library-main.narrow #library-batches {
    width: 1fr;
    height: auto;
    max-height: 40%;
}

#library-main.narrow #library-detail {
    width: 1fr;
}

.library-batch-heading {
    height: auto;
    color: $text-muted;
    padding: 0 1 1 1;
}

/* Queue screen: enqueue input, a bordered summary strip (overall bar + chips),
 * the batch-grouped jobs table, and a one-row footer of key actions (§4). */
#enqueue-input {
    margin: 0 0 1 0;
}

#queue-summary {
    height: auto;
    color: $text;
    margin: 0 0 1 0;
}

#queue-table {
    height: 1fr;
}

#queue-actions {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

/* Track screen: the header card, the match column, and the lyrics pane. */
.hidden {
    display: none;
}

/* Search screen: bordered input, filter chips, results panel with banners. */
#search-box {
    height: auto;
    margin: 0 0 1 0;
}

#search-box Input {
    border: none;
    background: $surface;
}

#filter-chips {
    height: 1;
    color: $text-secondary;
    text-style: bold;
    padding: 0 1 1 1;
}

#results-panel {
    height: 1fr;
}

#results-scroll {
    height: 1fr;
}

/* Universal-search section headers (Artists · N) and their stacked preview tables. */
.section-title {
    height: 1;
    color: $accent;
    text-style: bold;
    padding: 1 1 0 1;
}

.section-table {
    height: auto;
    max-height: 16;
    margin: 0 0 1 0;
}

.results-empty {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    padding: 1 1;
}

.banner {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    text-style: bold;
}

.banner--warn {
    color: $error;
}

.banner--degraded {
    color: $warning;
}

/* Track screen: the accent-bordered header card, matches column, lyrics pane. */
#track-header {
    height: auto;
    border-left: thick $accent;
    margin: 0 0 1 0;
}

#card-slot {
    height: auto;
}

.vote-cta {
    width: auto;
    margin: 1 0 0 0;
    background: $boost;
    color: $warning;
}

#track-actions {
    height: auto;
    padding: 1 0 0 0;
}

#track-body {
    layout: horizontal;
    height: 1fr;
}

#track-body.stacked {
    layout: vertical;
}

#matches {
    width: 1fr;
}

#lyrics-slot {
    width: 40;
    height: 1fr;
}

#track-body.stacked #lyrics-slot {
    width: 1fr;
    height: 1fr;
}

/* Header card for entity screens (track + collection): a bordered card with an
 * accent left bar and the kind in its border title (contract §4). */
EntityCard {
    height: auto;
    border: solid $border;
    border-left: thick $accent;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
    color: $text;
}

/* Collection screen: header card over a tracks table + a fixed side panel that
 * collapses under the top card when the terminal narrows (contract §4/§1). */
#collection-body {
    height: 1fr;
}

#collection-main {
    height: 1fr;
    layout: horizontal;
}

#collection-main.narrow {
    layout: vertical;
}

#collection-left {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#track-table {
    width: 1fr;
    height: 1fr;
    margin: 1 1 0 0;
}

/* Artist discography: a compact table under the top-tracks table. */
#discography-table {
    width: 1fr;
    height: auto;
    max-height: 16;
    margin: 1 1 0 0;
}

#collection-side {
    width: 32;
    height: 1fr;
    margin: 1 0 0 0;
}

#collection-main.narrow #track-table {
    width: 1fr;
    height: 1fr;
}

#collection-main.narrow #collection-side {
    width: 1fr;
    height: auto;
}

#collection-side Button {
    width: 100%;
    margin: 1 0 0 0;
}

.collection-meta {
    height: auto;
    color: $text;
}

.collection-note {
    height: auto;
    color: $text-muted;
    margin: 1 0 0 0;
}

/* Per-provider metadata provenance — the terminal "Sources" panel (track + collection). */
#collection-sources {
    height: auto;
    max-height: 20;
    margin: 1 0 0 0;
}

#track-sources {
    height: auto;
    max-height: 14;
    margin: 1 0 0 0;
}

.sources-panel {
    height: auto;
    color: $text;
}

#lyrics-inner {
    height: 1fr;
}

MatchGauge {
    height: auto;
    padding: 0 1;
}

MatchGauge:focus {
    background: $boost;
}

LyricsPane {
    height: 1fr;
    border: solid $border;
    border-title-color: $text-muted;
    border-subtitle-color: $text-muted;
    padding: 0 1;
    color: $text-muted;
}

LyricsPane:focus {
    border: solid $accent;
    border-title-color: $accent;
}
