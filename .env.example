# SpotDL Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Production Secrets
# =============================================================================

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Database password
DB_PASSWORD=your-secure-database-password

# =============================================================================
# OPTIONAL - Deployment Mode
# =============================================================================

# Deployment mode: 'self-hosted' (default) or 'hosted'
# - self-hosted: Full functionality including downloads
# - hosted: Public matching service only (no downloads)
# DEPLOYMENT_MODE=self-hosted

# =============================================================================
# OPTIONAL - Service Configuration
# =============================================================================

# CORS origins (comma-separated)
CORS_ORIGINS=https://spotdl.example.com

# Docker image configuration (for pulling pre-built images)
REGISTRY=ghcr.io
IMAGE_NAME=spotdl/spotify-downloader
IMAGE_TAG=latest

# =============================================================================
# OPTIONAL - External Services
# =============================================================================

# Spotify API credentials (optional, for enhanced metadata)
# SPOTIFY_CLIENT_ID=your-client-id
# SPOTIFY_CLIENT_SECRET=your-client-secret

# YouTube API key (optional, for enhanced search)
# YOUTUBE_API_KEY=your-api-key
