{
  "name": "spotdl-frontend",
  "version": "5.0.0",
  "description": "SpotDL Frontend - Self-hosted web interface",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
