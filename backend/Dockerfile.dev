# SpotDL Backend Development Dockerfile with Hot Reload
FROM python:3.13-slim

# Install build dependencies and curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Set working directory
WORKDIR /app

# Copy core package first (dependency)
COPY ./core /core

# Copy backend dependency files
COPY ./backend/pyproject.toml ./backend/uv.lock* ./

# Create virtual environment and install dependencies
RUN uv sync --frozen --no-install-project

# Install core package after sync (so it doesn't get removed)
RUN uv pip install -e /core

# Copy alembic config (migrations will be mounted)
COPY ./backend/alembic.ini .

# Create data directory
RUN mkdir -p /app/data

# Set environment variables
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8000

# Run with hot reload
CMD ["python", "-m", "uvicorn", "spotdl.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/src"]
