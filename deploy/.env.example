# deploy/.env.example
# ---------------------------------------------------------------------------
# Self-host configuration for the spotDL server. Copy to `.env` in the deploy/
# directory (docker compose reads it automatically) and fill in values.
#
#   cp deploy/.env.example deploy/.env
#
# This is the ONLY committed env file. Never commit your real `.env`.
# Every var below is read by spotdl_server.settings.Settings (SPOTDL_ prefix);
# uncommented values are the operator-relevant ones for a self-host stack — the
# rest are documented defaults you can override. Booleans accept true/false.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Signing key for auth tokens. MUST be set (compose fails fast otherwise).
# Generate one with:  openssl rand -hex 32
SPOTDL_AUTH_SECRET_KEY=

# --- Core / deployment ----------------------------------------------------
# selfhost (default) mounts the full UI + downloads surface. Leave as-is unless
# you know you want embedded (loopback, no auth) — hosted is for the community
# instance only (see docs/self-hosting/railway.md).
SPOTDL_MODE=selfhost
# Host port published on the docker host (container always listens on 8000).
SPOTDL_PORT=8000
# On-disk root for the SQLite DB, music library and temp files inside the
# container (the spotdl_data volume mounts here).
SPOTDL_DATA_DIR=/app/data

# --- Database -------------------------------------------------------------
# Default is a SQLite file under SPOTDL_DATA_DIR. Override with an async driver
# URL to use Postgres. When you enable the Postgres override compose file, set
# SPOTDL_DB_PASSWORD instead and leave this pointing at the `db` service.
SPOTDL_DATABASE_URL=sqlite+aiosqlite:////app/data/spotdl.db
# Password for the bundled Postgres service (docker-compose.postgres.yml only).
# SPOTDL_DB_PASSWORD=

# --- Observability (Plan 11 Task 1) --------------------------------------
# Optional Sentry DSN for error reporting (blank disables it).
SPOTDL_SENTRY_DSN=
# Log level for the structured JSON logs (DEBUG/INFO/WARNING/ERROR).
SPOTDL_LOG_LEVEL=INFO

# --- Auth / community (Plan 6) -------------------------------------------
# Leave blank to derive from mode (auth on for selfhost/hosted, off for
# embedded). Set explicitly to force on/off.
# SPOTDL_AUTH_ENABLED=
# SPOTDL_ACCESS_TOKEN_TTL_SECONDS=900
# SPOTDL_REFRESH_TOKEN_TTL_SECONDS=2592000
# SPOTDL_VOTING_ENABLED=true

# --- OAuth providers (a provider is enabled iff BOTH id + secret are set) --
# SPOTDL_GITHUB_CLIENT_ID=
# SPOTDL_GITHUB_CLIENT_SECRET=
# SPOTDL_DISCORD_CLIENT_ID=
# SPOTDL_DISCORD_CLIENT_SECRET=
# Public base URL used to build OAuth callbacks, e.g. https://spotdl.example.com
# SPOTDL_OAUTH_REDIRECT_BASE_URL=
# SPA origin for the OAuth browser handoff (blank -> same origin).
# SPOTDL_SPA_BASE_URL=
# SPOTDL_WEB_AUTH_REDIRECT_ENABLED=

# --- Rate limiting (Plan 6) ----------------------------------------------
# Blank derives from mode (on for hosted, off for selfhost). Set true to enable.
# SPOTDL_RATE_LIMIT_ENABLED=
# Redis URL enables the distributed rate limiter (needs the `redis` extra, which
# the published image already bakes in). Blank -> in-process limiter.
# SPOTDL_REDIS_URL=
# Trust a proxy-supplied client IP header for limiting + logs, e.g. cf-connecting-ip.
# SPOTDL_CLIENT_IP_HEADER=

# --- Spotify credentials (optional; bundled defaults used when blank) ------
# SPOTDL_SPOTIFY_CLIENT_ID=
# SPOTDL_SPOTIFY_CLIENT_SECRET=

# --- Downloads (Plan 7) ---------------------------------------------------
# SPOTDL_DOWNLOAD_CONCURRENCY=2
# SPOTDL_LIBRARY_PATH=            # blank -> SPOTDL_DATA_DIR/music
# SPOTDL_DOWNLOAD_TEMP_DIR=       # blank -> SPOTDL_DATA_DIR/temp
# SPOTDL_DEFAULT_OUTPUT_FORMAT=mp3
# SPOTDL_DEFAULT_BITRATE=auto
# SPOTDL_DEFAULT_OUTPUT_TEMPLATE={artists} - {title}.{output-ext}
# SPOTDL_FFMPEG_PATH=ffmpeg
# SPOTDL_DOWNLOAD_COOKIE_FILE=
# SPOTDL_DOWNLOAD_PROXY=
# SPOTDL_YTDLP_ARGS=
# SPOTDL_FFMPEG_ARGS=
# SPOTDL_DOWNLOADS_REQUIRE_AUTH=false
# SPOTDL_PROGRESS_THROTTLE_MS=500
# SPOTDL_DOWNLOAD_DRAIN_TIMEOUT_S=30
# X-Accel prefix for reverse-proxy accelerated file delivery (see Caddyfile.example).
# SPOTDL_DOWNLOAD_X_ACCEL_PREFIX=
# SPOTDL_WS_PROGRESS_REQUIRE_AUTH=
# SPOTDL_DOWNLOAD_RESTRICT=none
# SPOTDL_DOWNLOAD_MAX_FILENAME_LENGTH=
# SPOTDL_DOWNLOAD_ID3_SEPARATOR=/
# SPOTDL_DOWNLOAD_DETECT_FORMATS=
# SPOTDL_DOWNLOAD_SKIP_EXPLICIT=false
# SPOTDL_DOWNLOAD_RESPECT_SKIP_FILE=false
# SPOTDL_DOWNLOAD_CREATE_SKIP_FILE=false
# SPOTDL_DOWNLOAD_PLAYLIST_NUMBERING=false
# SPOTDL_DOWNLOAD_RETAIN_TRACK_COVER=false
# SPOTDL_DOWNLOAD_ADD_UNAVAILABLE=false
# SPOTDL_DOWNLOAD_SCAN_EXISTING=false
# SPOTDL_DB_ECHO=false
