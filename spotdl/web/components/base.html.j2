<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <title>spotdl</title>
    <style>
      .spotdl-navbar { display:flex; flex-wrap:wrap; gap:.5rem; }
      .spotdl-brand { width:auto; flex:0 0 auto; }
      .spotdl-actions { width:auto; margin-left:auto; flex:0 0 auto; }
      .spotdl-search { display:flex; flex:1 1 18rem; min-width:0; }
      .spotdl-search #search-input { min-width:0; gap:.5rem; }
      .spotdl-search #search-button { flex-shrink:0; }
      #download-list { min-width:0; overflow-wrap:anywhere; }
      #download-list .carousel { max-width:100%; }
      #component-settings-content { width:min(36rem,calc(100vw - 2rem)); max-width:100%; }
      #component-settings-content fieldset { min-width:0; width:100%; }
      @media (max-width:767px) {
        .spotdl-search { order:3; flex-basis:100%; width:100%; padding-bottom:.5rem; }
        .spotdl-brand { margin:0; padding:0 .25rem; }
        .spotdl-actions .btn { margin:.125rem; }
        .spotdl-actions .indicator { margin:0 .25rem; }
        #input-rotating-placeholder { font-size:16px; }
        #download-list .card-body { min-width:0; }
      }
    </style>
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Import Datastar -->
    <!-- <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@main/bundles/datastar.js"></script> -->
    <script type="module" src="/assets/datastar.js"></script>

    <!-- Import DaisyUI -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" /> -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" /> -->
    <link href="/assets/daisyui@5.css" rel="stylesheet" type="text/css" />
    <link href="/assets/themes.css" rel="stylesheet" type="text/css" />

    <!-- Import tailwindcss -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> -->
    <script src="/assets/tailwindcss/browser@4.js"></script>

    <!-- Import Iconify -->
    <!-- <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script> -->
    <script src="/assets/iconify-icon/iconify-icon.min.js"></script>
</head>

<style>
    iconify-icon {
        display: inline-block;
        width: 1em;
        height: 1em;
    }
</style>

<script>
    function goto(location) {
        window.location.href = location;
    }
</script>

<body data-signals="{'client_id': ''}"
    data-on-load="$client_id = localStorage.getItem('client_id'); @get('/client/load')" data-theme="forest">

    <div class="bg-base-300 absolute w-full t-0">
        {% include "navbar.html.j2" %}

        <!-- Content -->
        {% block content %}
        {% endblock content %}

        <!-- DEBUG: Display all signals -->


        {#
        <pre data-json-signals></pre> #}


        <!-- Footer -->
        {% include "footer.html.j2" %}

        <!-- Settings -->
        <span id="component-settings"
            data-on-signal-patch="@get('/client/component/settings-content'); localStorage.setItem('client_id', $client_id);"
            data-on-signal-patch-filter="{include: /client_id/}">
        </span>
        <dialog id="settings_modal" class="modal">
            <!-- Settings Modal Content -->
            <div id="component-settings-content"></div>
            <form method="dialog" class="modal-backdrop">
                <button>close</button>
            </form>
        </dialog>

    </div>

</body>

</html>